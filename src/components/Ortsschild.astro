---
// Bildmarke im Stil des Ortsschilds – als Text nachgebaut, damit sie in jeder Größe scharf bleibt.
// voll: alle Zeilen wie auf dem echten Schild (Fußzeile); sonst kompakt für die Kopfzeile.
const { voll = false } = Astro.props;
---
{voll ? (
  <span class="ortsschild ortsschild--voll">
    <strong>Stockhausen</strong>
    <small>Stadt</small>
    <strong class="ortsschild__stadt">Herbstein</strong>
    <small>Vogelsbergkreis</small>
  </span>
) : (
  <span class="ortsschild">
    <strong>Stockhausen</strong>
    <small>Stadt Herbstein</small>
  </span>
)}

<style>
  .ortsschild {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 0.4rem 1rem 0.45rem;
    background: #f7c600;
    color: #111;
    border-radius: 7px;
    box-shadow: inset 0 0 0 2px #f7c600, inset 0 0 0 3.5px #111, 0 1px 3px rgb(0 0 0 / 0.18);
    font-family: var(--sans);
    line-height: 1.05;
    text-align: center;
    white-space: nowrap;
  }
  strong { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.01em; }
  small { font-size: 0.66rem; font-weight: 500; }

  .ortsschild--voll { padding: 0.75rem 1.4rem 0.8rem; border-radius: 10px; box-shadow: inset 0 0 0 3px #f7c600, inset 0 0 0 5px #111; gap: 0.08rem; }
  .ortsschild--voll strong { font-size: 1.45rem; }
  .ortsschild--voll .ortsschild__stadt { font-size: 1.25rem; }
  .ortsschild--voll small { font-size: 0.85rem; }
</style>

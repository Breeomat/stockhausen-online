---
// Bildmarke im Stil des Ortsschilds – als Text nachgebaut, damit sie in jeder Größe scharf bleibt.
// groesse skaliert das ganze Schild (1 = Fußzeile).
const { groesse = 1 } = Astro.props;
---
<span class="ortsschild" style={`font-size: ${groesse}rem`}>
  <strong>Stockhausen</strong>
  <small>Stadt</small>
  <strong class="ortsschild__stadt">Herbstein</strong>
  <small>Vogelsbergkreis</small>
</span>

<style>
  .ortsschild {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.08em;
    padding: 0.75em 1.4em 0.8em;
    background: #f7c600;
    color: #111;
    border-radius: 0.65em;
    box-shadow: inset 0 0 0 0.19em #f7c600, inset 0 0 0 0.31em #111, 0 1px 3px rgb(0 0 0 / 0.18);
    font-family: var(--sans);
    line-height: 1.05;
    text-align: center;
    white-space: nowrap;
  }
  strong { font-size: 1.45em; font-weight: 700; letter-spacing: -0.01em; }
  .ortsschild__stadt { font-size: 1.25em; }
  small { font-size: 0.85em; font-weight: 500; }
</style>

  {name === 'Laden' && (
    <>
      <path d="M3 9.5 4.5 4h15L21 9.5" />
      <path d="M3 9.5c0 1.4 1 2.5 2.25 2.5S7.5 10.9 7.5 9.5c0 1.4 1 2.5 2.25 2.5S12 10.9 12 9.5c0 1.4 1 2.5 2.25 2.5s2.25-1.1 2.25-2.5c0 1.4 1 2.5 2.25 2.5S21 10.9 21 9.5" />
      <path d="M5 12v8h14v-8" />
      <path d="M10 20v-5h4v5" />
    </>
  )}
  {name === 'Einkaufen' && (
    <>
      <path d="M5 8h14l-1.2 11.1a1 1 0 0 1-1 .9H7.2a1 1 0 0 1-1-.9z" />
      <path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
    </>
  )}
  {name === 'Gastronomie' && (
    <>
      <path d="M5 3v6a2 2 0 0 0 4 0V3" />
      <path d="M7 11v10" />
      <path d="M17 21V3c-2.2 1.2-3 3.6-3 6.5V13h3" />
    </>
  )}
  {name === 'Handwerk' && (
    <>
      <path d="m14 6 4 4" />

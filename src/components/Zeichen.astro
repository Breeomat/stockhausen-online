---
// Platzhalter-Bildmarke, bis das Ortswappen als Datei vorliegt.
const { groesse = 36 } = Astro.props;
---
<svg width={groesse} height={groesse} viewBox="0 0 40 40" aria-hidden="true">
  <rect width="40" height="40" rx="11" fill="var(--meer)" />
  <circle cx="28" cy="13" r="4" fill="var(--gold)" />
  <path d="M0 29 Q10 19 19 25 T40 22 V40 H0Z" fill="var(--aprikose)" />
  <path d="M0 33 Q13 26 24 31 T40 30 V40 H0Z" fill="var(--ziegel)" />
</svg>

---
import { Image, getImage } from 'astro:assets';
import type { Plakat } from '../lib/plakate';
import { url } from '../lib/site';

// zeigen/fest: nur `zeigen` Plakate anzeigen; die ersten `fest` bleiben, die übrigen Plätze wechseln je Besuch
interface Props { liste: Plakat[]; archiv?: boolean; zeigen?: number; fest?: number }
const { liste, archiv = false, zeigen, fest = 0 } = Astro.props;
const gross = await Promise.all(liste.map((p) => getImage({ src: p.bild, width: Math.min(p.bild.width, 1400), format: 'webp' })));
const bis = (iso: string) => new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long' }).format(new Date(`${iso}T12:00:00`));
---
<ul class:list={['plakate', { 'plakate--archiv': archiv }]} data-zeigen={zeigen} data-fest={zeigen ? fest : undefined}>
  {liste.map((p, i) => (
    <li id={`plakat-${p.id}`} hidden={zeigen !== undefined && i >= zeigen}>
      <button class="plakat" data-gross={gross[i].src} data-titel={p.data.titel}>
        <Image src={p.bild} alt={`Plakat: ${p.data.titel}`} widths={[320, 480, 720]} sizes="(max-width: 640px) 50vw, 280px" />
      </button>
      <p class="plakat__unter">
        <strong>{p.data.titel}</strong>
        <span>{[p.data.verein, archiv ? null : `bis ${bis(p.data.gueltig_bis)}`].filter(Boolean).join(' · ')}</span>
        <a class="plakat__teilen" href={url(`plakate/${p.id}/`)} data-titel={p.data.titel}>Teilen</a>
      </p>
    </li>
  ))}
</ul>

<dialog class="leuchtkasten" aria-label="Plakat in groß">
  <form method="dialog"><button class="leuchtkasten__zu" aria-label="Schließen">×</button></form>
  <img alt="" />
</dialog>

<script>
  // Wechselnde Plätze: die ersten `fest` Plakate bleiben, die restlichen Plätze werden zufällig aus den übrigen gefüllt
  document.querySelectorAll<HTMLUListElement>('.plakate[data-zeigen]').forEach((ul) => {
    const zeigen = Number(ul.dataset.zeigen);
    const fest = Number(ul.dataset.fest) || 0;
    const alle = [...ul.querySelectorAll<HTMLLIElement>(':scope > li')];
    const rest = alle.slice(fest).map((li) => ({ li, r: Math.random() })).sort((a, b) => a.r - b.r).map(({ li }) => li);
    const auswahl = rest.slice(0, Math.max(0, zeigen - fest));
    alle.forEach((li, i) => (li.hidden = i >= fest && !auswahl.includes(li)));
    auswahl.forEach((li) => ul.append(li));
  });
  document.querySelectorAll<HTMLButtonElement>('.plakat').forEach((knopf) => {
    knopf.addEventListener('click', () => {
      const kasten = knopf.closest('ul')?.nextElementSibling as HTMLDialogElement | null;
      const bild = kasten?.querySelector('img');
      if (!kasten || !bild) return;
      bild.src = knopf.dataset.gross ?? '';
      bild.alt = `Plakat: ${knopf.dataset.titel}`;
      kasten.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('.leuchtkasten').forEach((kasten) => {
    kasten.addEventListener('click', (e) => { if (e.target === kasten) kasten.close(); });
  });
  // Teilen: eigene Seite des Plakats (mit dem Plakat als Vorschaubild) über das Teilen-Menü des Handys, sonst Link kopieren
  document.querySelectorAll<HTMLAnchorElement>('.plakat__teilen').forEach((link) => {
    link.addEventListener('click', async (e) => {
      const ziel = link.href;
      if (navigator.share) {
        e.preventDefault();
        try { await navigator.share({ title: link.dataset.titel, url: ziel }); } catch { /* abgebrochen */ }
      } else if (navigator.clipboard) {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(ziel);
          link.textContent = 'Link kopiert';
          setTimeout(() => (link.textContent = 'Teilen'), 2000);
        } catch { location.href = ziel; }
      }
    });
  });
  // Link aus einem Termin (#plakat-<id>): Plakat sichtbar machen und groß öffnen
  const ziel = location.hash.startsWith('#plakat-') ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
  if (ziel && !ziel.hidden) {
    const archiv = ziel.closest('details');
    if (archiv) archiv.open = true;
    ziel.scrollIntoView({ block: 'center' });
    ziel.querySelector<HTMLButtonElement>('.plakat')?.click();
  }
</script>

<style>
  .plakate {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 2rem 1.5rem;
  }
  @media (max-width: 520px) { .plakate { grid-template-columns: 1fr 1fr; gap: 1.5rem 1rem; } }
  .plakat {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--flaeche);
    border-radius: 10px;
    overflow: hidden;
    cursor: zoom-in;
    box-shadow: var(--schatten);
    transform: rotate(-0.6deg);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .plakate li[hidden] { display: none; }
  .plakate li:nth-child(even) .plakat { transform: rotate(0.7deg); }
  .plakat:hover, .plakate li:nth-child(even) .plakat:hover { transform: rotate(0) scale(1.02); }
  .plakat img { width: 100%; aspect-ratio: 1 / 1.414; object-fit: cover; }
  .plakate--archiv .plakat { filter: grayscale(0.6); opacity: 0.85; }
  .plakat__unter { margin: 0.75rem 0 0; display: flex; flex-direction: column; font-size: 0.92rem; line-height: 1.35; }
  .plakat__unter span { color: var(--text-leise); font-size: 0.85rem; }
  .plakat__teilen { width: fit-content; margin-top: 0.3rem; font-size: 0.85rem; font-weight: 600; }
  .plakat__teilen::before { content: '↗ '; }

  .leuchtkasten {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 820px);
    max-height: 92vh;
  }
  .leuchtkasten::backdrop { background: rgb(20 16 12 / 0.82); backdrop-filter: blur(4px); }
  .leuchtkasten img { max-height: 88vh; width: auto; margin-inline: auto; border-radius: 8px; }
  .leuchtkasten__zu {
    position: fixed;
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: #fff;
    color: #2a211c;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

---
// „Brummi“ – kleine Haustier-Drohne (übernommen von ahne.de): folgt Maus/Finger mit Verzögerung, landet bei Langeweile
// auf Überschriften, fliegt mit leerem Akku zur Ladestation, schläft nachts (22–6 Uhr) und ist beim Wecken mürrisch.
// Ohne Bewegung bei prefers-reduced-motion. Eingebaut auf dem Drohnenflug (/dorf/karte/drohnenflug/).
const texte = {
  tippen: ['Bsssss!', 'Akku bei {a} %.', 'Nicht kitzeln!', 'Brummi, zu Diensten.', 'Ich hab das Dorf im Blick.', 'Ich war heute schon über Schadges.'],
  leer: 'Akku fast leer – ab nach Hause!',
  voll: 'Voll geladen. Weiter geht’s!',
  langweilig: ['Langweilig …', 'Hallo? Jemand da?', 'Ich dreh mal ’ne Runde.'],
  geweckt: ['Hmpf … es ist mitten in der Nacht.', 'Fünf Minuten noch …', 'Wer stört?'],
  gutenacht: 'Gute Nacht.',
  hallo: ['Na? Tipp mich an!', 'Ich halte still. Versprochen.', 'Hallo da oben!'],
  plaudern: [
    'Schönes Dorf, oder?', 'Einfach weiterscrollen, dann fliegen wir übers Dorf.', 'Ich zähle die Dächer. Eins, zwei, drei …',
    'Brumm brumm.', 'Oben rechts kannst du zwischen echtem Luftbild und Karte umschalten.', 'Das Luftbild ist echt. Siehst du das Schloss?',
    'Ich hab den Sportplatz im Visier.', 'Kurz die Rotoren lüften …', 'Tipp mich an, ich erzähl dir was.', 'Auf der Karte sieht man jeden Feldweg.',
    'Fliegst du mit? Einfach scrollen.', 'Hier oben ist es ganz schön windig.', 'Unten in der Leiste steht, wo wir gerade sind.',
    'Mein Akku hält nicht ewig. Dann muss ich zur Ladestation.', 'Wenn ich schlafe, bitte nicht wecken. Oder doch?',
    'Vom Kirchturm aus sieht man fast so weit wie ich.', 'Ganz schön viele rote Dächer hier.', 'Die Altfellhalle erkenne ich am roten Dach.',
  ],
  zurueck: 'Da bist du ja wieder!',
  station: 'Brummis Ladestation',
  name: 'Brummi, die Haustier-Drohne',
};
---
<div class="brummi-station" aria-hidden="true"><span>H</span><small>{texte.station}</small></div>
<button type="button" class="brummi" aria-label={texte.name} data-texte={JSON.stringify(texte)}>
  <span class="brummi__blase" aria-live="polite"></span>
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <g class="brummi__arme"><line x1="16" y1="16" x2="48" y2="48" /><line x1="48" y1="16" x2="16" y2="48" /></g>
    {[[16, 16], [48, 16], [16, 48], [48, 48]].map(([x, y]) => (
      <g transform={`translate(${x} ${y})`}><circle r="10" class="brummi__ring" /><g class="brummi__rotor"><ellipse rx="9" ry="1.8" /><ellipse rx="9" ry="1.8" transform="rotate(90)" /></g></g>
    ))}
    <rect x="23" y="23" width="18" height="18" rx="6" class="brummi__koerper" />
    <circle cx="28" cy="30" r="2.2" class="brummi__auge" /><circle cx="36" cy="30" r="2.2" class="brummi__auge" />
    <path d="M28 36 Q32 39 36 36" class="brummi__mund" />
  </svg>
  <span class="brummi__akku"><i></i></span>
  <span class="brummi__zzz" aria-hidden="true">z<span>z</span><span>z</span></span>
</button>

<script>
  const brummi = document.querySelector<HTMLButtonElement>('.brummi')!;
  const station = document.querySelector<HTMLElement>('.brummi-station')!;
  const blase = brummi.querySelector<HTMLElement>('.brummi__blase')!;
  const akkuBalken = brummi.querySelector<HTMLElement>('.brummi__akku i')!;
  const t = JSON.parse(brummi.dataset.texte!);
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const zufall = <T,>(liste: T[]) => liste[Math.floor(Math.random() * liste.length)];
  const nacht = () => { const h = Number(new Intl.DateTimeFormat('de-DE', { timeZone: 'Europe/Berlin', hour: 'numeric', hourCycle: 'h23' }).format(new Date())); return h >= 22 || h < 6; };

  // Sprüche ohne Wiederholung: erst alle einmal (gemischt), dann neu mischen
  const beutel: string[] = [];
  const naechster = () => {
    if (!beutel.length) beutel.push(...[...t.plaudern, ...t.tippen].sort(() => Math.random() - 0.5));
    return beutel.pop()!;
  };

  type Zustand = 'folgen' | 'bummeln' | 'heim' | 'laden' | 'schlafen';
  let zustand: Zustand = 'bummeln';
  let pos = { x: innerWidth * 0.8, y: innerHeight * 0.3 };
  let tempo = { x: 0, y: 0 };
  let ziel = { ...pos };
  let akku = 100;
  let zuletztBewegt = 0;
  let wachBis = 0;
  let bummelZiel = { x: pos.x, y: pos.y, bis: 0 };
  let blaseZeit: number | undefined;

  function sagen(text: string, ms = 2600) {
    blase.textContent = text.replace('{a}', String(Math.round(akku)));
    brummi.classList.add('spricht');
    clearTimeout(blaseZeit);
    blaseZeit = window.setTimeout(() => brummi.classList.remove('spricht'), ms);
  }

  const stationsPunkt = () => {
    const r = station.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + 6 };
  };

  // Maus/Finger: Brummi folgt mit Abstand (leicht versetzt, damit er nicht unter dem Zeiger klebt)
  // Kommt die Maus nahe heran, hält Brummi still, damit man ihn anklicken kann.
  let halloZeit = -Infinity;
  addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch' && !e.isPrimary) return;
    const jetzt = performance.now();
    if (zustand === 'bummeln' && zuletztBewegt && jetzt - zuletztBewegt > 20000 && !brummi.classList.contains('spricht')) sagen(t.zurueck);
    zuletztBewegt = jetzt;
    const nah = e.pointerType !== 'touch' && Math.hypot(e.clientX - pos.x, e.clientY - pos.y) < 70;
    if (nah && (zustand === 'folgen' || zustand === 'bummeln')) {
      ziel = { ...pos };
      zustand = 'folgen';
      if (jetzt - halloZeit > 20000 && !brummi.classList.contains('spricht')) { halloZeit = jetzt; sagen(zufall(t.hallo)); }
      return;
    }
    ziel = { x: e.clientX + 30, y: e.clientY - 28 };
    if (zustand === 'bummeln') zustand = 'folgen';
  }, { passive: true });
  addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('.brummi')) return;
    zuletztBewegt = performance.now();
    ziel = { x: e.clientX + 30, y: e.clientY - 28 };
    if (zustand === 'bummeln') zustand = 'folgen';
  }, { passive: true });

  brummi.addEventListener('click', () => {
    if (zustand === 'schlafen') {
      sagen(zufall(t.geweckt), 3200);
      brummi.classList.add('muerrisch');
      wachBis = performance.now() + 15000;
      zustand = 'bummeln';
      return;
    }
    sagen(naechster());
    tempo.y -= 6; // kleiner Hüpfer
  });

  // Langeweile: eine zufällige Überschrift anfliegen oder kleine Kreise drehen
  function neuesBummelZiel(jetzt: number) {
    const ueberschriften = [...document.querySelectorAll<HTMLElement>('main h1, main h2')].filter((h) => {
      const r = h.getBoundingClientRect();
      return r.top > 60 && r.bottom < innerHeight - 90;
    });
    if (ueberschriften.length && Math.random() < 0.6) {
      const r = zufall(ueberschriften).getBoundingClientRect();
      bummelZiel = { x: r.left + Math.min(r.width, 260) * Math.random(), y: r.top - 18, bis: jetzt + 5000 + Math.random() * 3000 };
    } else {
      bummelZiel = { x: innerWidth * (0.15 + Math.random() * 0.7), y: innerHeight * (0.2 + Math.random() * 0.5), bis: jetzt + 4000 };
      if (Math.random() < 0.35) sagen(zufall(t.langweilig));
    }
  }

  // Ab und zu von selbst etwas sagen (nicht zu oft): erstmals nach ~15 s, dann alle 40–70 s
  let naechsterSpruch = performance.now() + 15000;
  function plaudern(jetzt: number) {
    if (jetzt < naechsterSpruch) return;
    if (document.hidden || brummi.classList.contains('spricht') || (zustand !== 'folgen' && zustand !== 'bummeln')) { naechsterSpruch = jetzt + 8000; return; }
    naechsterSpruch = jetzt + 40000 + Math.random() * 30000;
    sagen(naechster(), 3200);
  }

  let vorher = performance.now();
  function schritt(jetzt: number) {
    const dt = Math.min(0.05, (jetzt - vorher) / 1000);
    vorher = jetzt;

    // Zustandswechsel
    if (zustand !== 'laden' && zustand !== 'heim' && zustand !== 'schlafen' && akku < 15) {
      zustand = 'heim';
      sagen(t.leer);
    }
    if (zustand === 'folgen' && jetzt - zuletztBewegt > 6000) zustand = 'bummeln';
    if ((zustand === 'bummeln' || zustand === 'folgen') && nacht() && jetzt > wachBis && jetzt - zuletztBewegt > 4000) {
      zustand = 'heim';
      if (wachBis) sagen(t.gutenacht);
    }

    let z = ziel;
    if (zustand === 'bummeln') {
      if (jetzt > bummelZiel.bis) neuesBummelZiel(jetzt);
      z = { x: bummelZiel.x + Math.sin(jetzt / 900) * 26, y: bummelZiel.y + Math.cos(jetzt / 700) * 10 };
    } else if (zustand === 'heim' || zustand === 'laden' || zustand === 'schlafen') {
      z = stationsPunkt();
      const abstand = Math.hypot(z.x - pos.x, z.y - pos.y);
      if (zustand === 'heim' && abstand < 8) zustand = nacht() ? 'schlafen' : 'laden';
    }

    // Federweg zum Ziel
    const kraft = zustand === 'folgen' ? 9 : 5;
    tempo.x += (z.x - pos.x) * kraft * dt;
    tempo.y += (z.y - pos.y) * kraft * dt;
    tempo.x *= 0.9;
    tempo.y *= 0.9;
    pos.x += tempo.x * dt * 4.5; // 25 % langsamer als anfangs (6)
    pos.y += tempo.y * dt * 4.5;

    // Akku
    const fliegt = zustand === 'folgen' || zustand === 'bummeln' || zustand === 'heim';
    if (fliegt) akku = Math.max(0, akku - 0.8 * dt);
    if (zustand === 'laden') {
      akku = Math.min(100, akku + 14 * dt);
      if (akku >= 100) { zustand = 'bummeln'; sagen(t.voll); }
    }
    if (zustand === 'schlafen') akku = Math.min(100, akku + 14 * dt);
    if (zustand === 'schlafen' && !nacht()) zustand = 'laden';
    if (zustand !== 'schlafen' && jetzt > wachBis) brummi.classList.remove('muerrisch');

    const neigung = Math.max(-25, Math.min(25, tempo.x * 1.2));
    const wippen = zustand === 'laden' || zustand === 'schlafen' ? 0 : Math.sin(jetzt / 260) * 3;
    brummi.style.transform = `translate(${(pos.x - 21).toFixed(1)}px, ${(pos.y - 21 + wippen).toFixed(1)}px)`;
    brummi.style.setProperty('--neigung', `${neigung.toFixed(1)}deg`);
    brummi.dataset.zustand = zustand;
    akkuBalken.style.width = `${akku.toFixed(0)}%`;
    brummi.classList.toggle('schwach', akku < 25);
    plaudern(jetzt);
    requestAnimationFrame(schritt);
  }

  if (ruhig) {
    // ohne Bewegung: sitzt auf der Ladestation
    const s = stationsPunkt();
    brummi.style.transform = `translate(${s.x - 21}px, ${s.y - 21}px)`;
    brummi.dataset.zustand = 'laden';
    brummi.addEventListener('click', () => sagen(naechster()));
  } else {
    requestAnimationFrame(schritt);
  }
</script>

<style>
  .brummi {
    position: fixed; left: 0; top: 0; z-index: 45; width: 42px; height: 42px; padding: 0; border: 0; background: none;
    cursor: pointer; -webkit-tap-highlight-color: transparent; will-change: transform;
    filter: drop-shadow(0 8px 10px rgb(0 0 0 / 0.5));
  }
  .brummi svg { width: 100%; height: 100%; display: block; overflow: visible; rotate: var(--neigung, 0deg); }
  .brummi__arme line { stroke: #8a94a4; stroke-width: 4; stroke-linecap: round; }
  .brummi__ring { fill: rgb(10 12 24 / 0.35); stroke: #ffd76a; stroke-width: 1.4; }
  .brummi__rotor { animation: brummi-rotor 0.16s linear infinite; }
  .brummi__rotor ellipse { fill: rgb(230 236 245 / 0.6); }
  @keyframes brummi-rotor { to { rotate: 360deg; } }
  .brummi__koerper { fill: #1a1d26; stroke: #ffd76a; stroke-width: 1.6; }
  .brummi__auge { fill: #9ff5dc; }
  .brummi__mund { fill: none; stroke: #9ff5dc; stroke-width: 1.6; stroke-linecap: round; }
  .brummi.muerrisch .brummi__mund { d: path('M28 38 Q32 35 36 38'); }
  .brummi.muerrisch .brummi__auge { fill: #ffb36b; }
  .brummi[data-zustand='schlafen'] .brummi__auge { transform: scaleY(0.15); transform-box: fill-box; transform-origin: center; }
  .brummi[data-zustand='schlafen'] .brummi__rotor,
  .brummi[data-zustand='laden'] .brummi__rotor { animation: none; }
  .brummi__akku { position: absolute; left: 10px; right: 10px; bottom: -4px; height: 3px; border-radius: 2px; background: rgb(255 255 255 / 0.15); overflow: hidden; }
  .brummi__akku i { display: block; height: 100%; width: 100%; background: #9ff5dc; transition: width 0.3s; }
  .brummi.schwach .brummi__akku i { background: #ff6b7d; }
  .brummi[data-zustand='laden'] .brummi__akku i { background: #ffd76a; animation: brummi-laden 1s ease-in-out infinite; }
  @keyframes brummi-laden { 50% { opacity: 0.5; } }

  .brummi__blase {
    position: absolute; bottom: calc(100% + 6px); left: 50%; translate: -50% 4px; width: max-content; max-width: 210px;
    padding: 0.35rem 0.6rem; border-radius: 10px; background: #fcf8ec; color: #1a1406;
    font: 600 0.78rem/1.3 var(--sans); text-align: center; opacity: 0; pointer-events: none; transition: opacity 0.25s, translate 0.25s;
  }
  .brummi__blase::after { content: ''; position: absolute; top: 100%; left: 50%; translate: -50% 0; border: 6px solid transparent; border-top-color: #fcf8ec; }
  .brummi.spricht .brummi__blase { opacity: 1; translate: -50% 0; }

  .brummi__zzz { position: absolute; top: -10px; right: -6px; font: 700 0.8rem var(--sans); color: #c9d4ff; opacity: 0; }
  .brummi__zzz span { font-size: 0.9em; margin-left: 2px; }
  .brummi[data-zustand='schlafen'] .brummi__zzz { opacity: 1; animation: brummi-zzz 2.4s ease-in-out infinite; }
  @keyframes brummi-zzz { 0% { translate: 0 6px; opacity: 0; } 30% { opacity: 1; } 100% { translate: 8px -14px; opacity: 0; } }

  .brummi-station {
    position: fixed; left: 16px; bottom: 70px; z-index: 44; display: flex; flex-direction: column; align-items: center; gap: 2px;
    pointer-events: none;
  }
  .brummi-station span {
    width: 54px; height: 16px; border-radius: 50%; display: grid; place-items: center;
    background: radial-gradient(circle, rgb(255 215 106 / 0.35), rgb(10 12 24 / 0.7) 70%); border: 1px solid rgb(255 215 106 / 0.6);
    font: 800 0.6rem var(--sans); color: #ffd76a;
  }
  .brummi-station small { font: 600 0.58rem ui-monospace, Menlo, Consolas, monospace; letter-spacing: 0.06em; color: rgb(255 215 106 / 0.75); white-space: nowrap; }
</style>

---
import { Image } from 'astro:assets';
import Basis from '../../../layouts/Basis.astro';
import TerminKarte from '../../../components/TerminKarte.astro';
import { kommendeTermine } from '../../../lib/termine';
import { url } from '../../../lib/site';
import wappen from '../../../assets/fotos/sv-stockhausen-wappen.png';
import beachFoto from '../../../assets/fotos/sv-beachvolleyball.jpg';
import turnFoto from '../../../assets/fotos/sv-turnkinder-nikolaus.jpg';
import sportplatzFoto from '../../../assets/fotos/sv-sportplatz-luftbild.jpg';
import fussballFoto from '../../../assets/fotos/sv-fussball.jpg';
import faschingFoto from '../../../assets/fotos/sv-fasching.jpg';

const termine = (await kommendeTermine()).filter((t) => t.data.verein === 'SV Stockhausen');

const abteilungen = [
  { name: 'Fußball', text: 'Jugend- und Seniorenmannschaften' },
  { name: 'Leichtathletik und Turnen', text: 'Vom Nachwuchs bis zum Sportabzeichen' },
  { name: 'Tischtennis', text: 'Hobby- und Mannschaftsbetrieb' },
  { name: 'Volleyball', text: 'Damen' },
  { name: 'Damengymnastik', text: '' },
  { name: 'Theatergruppe', text: 'Das kulturelle Highlight im Verein' },
];

const vorstand = [
  ['1. Vorsitzender', 'Michael Eidmann'],
  ['2. Vorsitzender', 'Max Wahl'],
  ['Rechnerin', 'Lena Biermann'],
  ['Schriftführer', 'Michael Roth'],
];

const erweitert = [
  ['Fußball Senioren', 'Jakob Christen'],
  ['Leichtathletik und Turnen', 'Christian Lips'],
  ['Tischtennis', 'Felix Mertin'],
  ['Volleyball Damen', 'Katrin Eidmann'],
  ['Damengymnastik', 'Anneli Jäger'],
  ['Veranstaltungen', 'Moritz Mertin, Helene Kimpel, Nils Eidmann, Johannes Kimpel'],
];
---
<Basis titel="SV Stockhausen" beschreibung="SV Stockhausen e.V.: Fußball, Leichtathletik, Tischtennis, Volleyball, Gymnastik und Theater – Vorstand, Abteilungen und Termine.">
  <section class="huelle seitenkopf sv-kopf">
    <div>
      <a class="zurueck" href={url('vereine/')}>← Alle Vereine</a>
      <span class="kicker">Verein · seit 1946</span>
      <h1>SV Stockhausen e.V.</h1>
      <p>Der Sportverein steht für Bewegung, Gemeinschaft und Engagement im Dorfleben. Hier treffen sportliche Tradition und moderne Vereinsarbeit aufeinander.</p>
    </div>
    <Image class="sv-kopf__wappen" src={wappen} alt="Vereinswappen des SV Stockhausen e.V." width={220} />
  </section>

  <section class="huelle sv">
    <figure class="sv-foto">
      <Image src={beachFoto} alt="Beachvolleyball-Spiel im Sand am Sportplatz, ringsum viele Zuschauer, im Hintergrund das Fußballfeld und eine Pappelreihe" widths={[640, 1024, 1600]} sizes="(max-width: 1192px) calc(100vw - 32px), 1160px" loading="eager" />
      <figcaption>Beachvolleyball am Sportplatz · Foto: Marc Ahne</figcaption>
    </figure>

    <div>
      <span class="kicker">Was uns ausmacht</span>
      <h2>Sport und Kultur für Jung und Alt</h2>
      <p class="einleitung">Der Verein bietet ein vielfältiges Sport- und Freizeitangebot. Großen Wert legt er auf ein lebendiges Vereinsleben, Teamgeist und gemeinsame Erlebnisse.</p>
      <ul class="abteilungen">
        {abteilungen.map(({ name, text }) => (
          <li class="karte"><h3>{name}</h3>{text && <p>{text}</p>}</li>
        ))}
      </ul>
      <div class="galerie">
        <figure class="sv-foto">
          <Image src={fussballFoto} alt="Fußballspiel am Sportplatz: Ein Stürmer im roten Trikot vor dem Tor, umringt von Gegenspielern in Gelb, im Hintergrund Pappeln" widths={[640, 1024]} sizes="(max-width: 760px) calc(100vw - 32px), 572px" />
          <figcaption>Fußball am Sportplatz · Foto: Marc Ahne</figcaption>
        </figure>
        <figure class="sv-foto">
          <Image src={turnFoto} alt="Die Turnkinder in roten SV-Trikots auf Bänken in der Halle, daneben das Trainerteam" widths={[640, 1024]} sizes="(max-width: 760px) calc(100vw - 32px), 572px" />
          <figcaption>Die Turnkinder mit dem Trainerteam am Nikolausabend · Foto: Marc Ahne</figcaption>
        </figure>
        <figure class="sv-foto galerie__breit">
          <Image src={faschingFoto} alt="Faschingsauftritt auf der Bühne: Männergruppe als Rettungsschwimmer in gelben Shirts und roten Shorts vor dem bunten Schriftzug „Stockhausen Helau“, vorne ein Schild „Flamingos Reloaded“" widths={[640, 1024, 1600]} sizes="(max-width: 1192px) calc(100vw - 32px), 1160px" />
          <figcaption>Auch Fasching gehört zum Sportverein: Auftritt der „Flamingos Reloaded“ · Foto: Marc Ahne</figcaption>
        </figure>
      </div>
    </div>

    <div class="anlage">
      <div class="anlage__text">
        <span class="kicker">Unsere Sportanlage</span>
        <h2>Sportplatz, Altfellhalle und Sportlerheim</h2>
        <p>Rund um den Rasenplatz liegt alles beieinander: die Laufbahn, das Beachvolleyballfeld, die Turnhalle – die Altfellhalle – und das Sportlerheim.</p>
      </div>
      <figure class="sv-foto">
        <Image src={sportplatzFoto} alt="Luftbild der Sportanlage: Rasenplatz mit Laufbahn, links das Beachvolleyballfeld, oben die Altfellhalle mit rotem Dach und das Sportlerheim" widths={[640, 1024, 1600]} sizes="(max-width: 900px) calc(100vw - 32px), 700px" />
        <figcaption>Die Sportanlage von oben · Foto: Marc Ahne</figcaption>
      </figure>
    </div>

    {termine.length > 0 && (
      <div>
        <span class="kicker">Termine</span>
        <h2>Demnächst beim SV</h2>
        <div class="termine">{termine.map((t) => <TerminKarte termin={t} />)}</div>
      </div>
    )}

    <div class="spalten">
      <div class="karte kasten">
        <h3>Geschäftsführender Vorstand</h3>
        <dl class="liste">
          {vorstand.map(([amt, name]) => <div><dt>{amt}</dt><dd>{name}</dd></div>)}
        </dl>
      </div>
      <div class="karte kasten">
        <h3>Abteilungsleitungen und Veranstaltungen</h3>
        <dl class="liste">
          {erweitert.map(([amt, name]) => <div><dt>{amt}</dt><dd>{name}</dd></div>)}
        </dl>
      </div>
    </div>

    <div class="karte mitmachen">
      <span class="kicker">Mach mit!</span>
      <h2>Werde Teil des SV Stockhausen</h2>
      <p>Egal ob Sport, Kultur oder Ehrenamt – der Verein freut sich über jede Person, die ihn bereichert. Schau vorbei und lerne uns kennen.</p>
    </div>
  </section>
</Basis>

<style>
  .zurueck { display: block; width: fit-content; margin-bottom: 1.25rem; font-size: 0.9rem; text-decoration: none; }
  .sv-kopf { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; }
  .sv-kopf__wappen { width: clamp(120px, 18vw, 220px); height: auto; filter: drop-shadow(0 8px 18px rgb(0 0 0 / 0.15)); }
  @media (max-width: 640px) { .sv-kopf { grid-template-columns: 1fr; } .sv-kopf__wappen { order: -1; width: 110px; } }

  .sv { padding-block: 1rem 5rem; display: grid; gap: 3.5rem; }
  .sv-foto { margin: 0; }
  .sv-foto img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: 50% 60%; border-radius: var(--radius); box-shadow: var(--schatten); }
  .sv-foto figcaption { margin-top: 0.6rem; font-size: 0.85rem; color: var(--text-leise); }
  .galerie { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem; }
  .galerie img { aspect-ratio: 4 / 3; object-position: 50% 60%; }
  .galerie .galerie__breit { grid-column: 1 / -1; }
  .galerie .galerie__breit img { aspect-ratio: 16 / 9; object-position: 50% 50%; }
  @media (max-width: 760px) { .galerie { grid-template-columns: 1fr; } }
  .anlage { display: grid; grid-template-columns: 1fr 1.6fr; gap: 2.5rem; align-items: center; }
  .anlage .sv-foto img { aspect-ratio: 4 / 3; }
  .anlage__text p { color: var(--text-leise); }
  @media (max-width: 900px) { .anlage { grid-template-columns: 1fr; gap: 1.25rem; } }
  .einleitung { max-width: 62ch; color: var(--text-leise); }
  .abteilungen { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; }
  .abteilungen li { padding: 1.25rem 1.5rem; border-top: 4px solid var(--ziegel); }
  .abteilungen h3 { margin: 0; font-size: 1.2rem; }
  .abteilungen p { margin: 0.3rem 0 0; color: var(--text-leise); }

  .termine { display: grid; gap: 1rem; margin-top: 1.25rem; }

  .spalten { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start; }
  @media (max-width: 760px) { .spalten { grid-template-columns: 1fr; } }
  .kasten { padding: 1.5rem; }
  .kasten h3 { margin-bottom: 0.75rem; }
  .liste { margin: 0; display: grid; }
  .liste div { padding: 0.45rem 0; border-bottom: 1px solid var(--linie); }
  .liste div:last-child { border-bottom: 0; }
  .liste dt { font-size: 0.8rem; color: var(--text-leise); }
  .liste dd { margin: 0; font-weight: 600; }

  .mitmachen { padding: clamp(1.75rem, 4vw, 2.5rem); background: var(--ziegel-hell); border-color: color-mix(in srgb, var(--ziegel) 25%, transparent); }
  .mitmachen h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .mitmachen p { margin: 0; max-width: 60ch; }
</style>

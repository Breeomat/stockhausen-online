---
import { Image } from 'astro:assets';
import Basis from '../../../layouts/Basis.astro';
import TerminKarte from '../../../components/TerminKarte.astro';
import VereinRueckblicke from '../../../components/VereinRueckblicke.astro';
import { kommendeTermine } from '../../../lib/termine';
import { url } from '../../../lib/site';
import schlossFoto from '../../../assets/fotos/stockhausen-schloss.jpg';
import onsBladdTitel from '../../../assets/fotos/ons-bladd-titel.jpg';
import saellemoaTitel from '../../../assets/fotos/saellemoa-titel.jpg';
import schullTitel from '../../../assets/fotos/die-schull-is-ous-titel.jpg';
import trotzeTitel from '../../../assets/fotos/trotze-on-zirinke-titel.jpg';

// Quelle: Dossier „Arbeitskreis Dorfgeschichte Stockhausen“ (Drive, Oktober 2026)
const termine = (await kommendeTermine()).filter((t) => t.data.verein?.includes('Dorfgeschichte'));

// Aktive Mitglieder und Mitarbeit an den Büchern: Angaben von Michael Eichenauer (November 2026)
const aktive = ['Hans-Jürgen Döll', 'Martina Eichenauer', 'Michael Eichenauer', 'Christian Oestreich', 'Wilhelm Picker'];

// Ältere Bücher des Arbeitskreises, neueste zuerst
const buecher = [
  {
    titel: '„Ons Bladd!“', untertitel: 'Bie die Stockhäiser schwaddse – Die Mundart von Stockhausen im Vogelsberg', jahr: '2015', bild: onsBladdTitel,
    alt: 'Buchtitel „Ons Bladd! Bie die Stockhäiser schwaddse“ mit altem Farbfoto: Dorfstraße mit Ortsschild „Stockhausen Kreis Lauterbach“, dahinter die Kirche',
    mitarbeit: ['Hans-Jürgen Döll', 'Martina Eichenauer', 'Michael Eichenauer', 'Wilhelm Picker'],
  },
  {
    titel: '„Die Schull is ous!“', untertitel: 'Aus 400 Jahren Schulgeschichte von Stockhausen und Schadges', jahr: '2010', bild: schullTitel,
    alt: 'Buchtitel „Die Schull is ous!“: altes grünes Heft mit Etikett „Aus 400 Jahren Schulgeschichte von Stockhausen und Schadges“, Schriftzug wie mit Kreide',
    mitarbeit: ['Hans-Jürgen Döll', 'Martina Eichenauer', 'Michael Eichenauer', 'Wilhelm Picker', 'Hanne Maaser (für Schadges)'],
    daten: [
      ['Herausgeber', 'Der Magistrat der Stadt Herbstein · Arbeitskreis Dorfgeschichte Stockhausen'],
      ['ISBN', '978-3-929359-22-1'],
      ['Druck', 'Mergard, Lauterbach · Buchbindearbeiten Keller, Kleinlüder'],
      ['Förderung', 'Land Hessen über das Amt für den ländlichen Raum (Vogelsbergkreis)'],
    ],
  },
  {
    titel: '„Trotze on Zirinke“', untertitel: 'Aus der Geschichte von Stockhausen', jahr: '2005', bild: trotzeTitel,
    alt: 'Buchtitel „Trotze on Zirinke – Aus der Geschichte von Stockhausen“ mit einer farbigen Zeichnung von Schloss und Kirche',
    mitarbeit: ['Hans-Jürgen Döll', 'Martina Eichenauer', 'Michael Eichenauer', 'Helmut Fischer', 'Gerhard Heinemann', 'Wilhelm Picker'],
  },
];

const themen = ['Dorfchronik', 'Historisches Bildarchiv', 'Hofgeschichten', 'Ausstellungen', 'Ahnenforschung'];
---
<Basis bild={schlossFoto} titel="Arbeitskreis Dorfgeschichte" beschreibung="Arbeitskreis Dorfgeschichte Stockhausen: Ortschronik, Bildarchiv und Hofgeschichten – das Gedächtnis des Dorfes.">
  <section class="ak-held">
    <Image class="ak-held__bild" src={schlossFoto} alt="Schloss Stockhausen: langgestreckter Barockbau mit Uhrturm hinter einer Rasenfläche mit Teich" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="huelle ak-kopf">
      <a class="zurueck" href={url('vereine/')}>← Alle Vereine</a>
      <span class="kicker">Heimatforschung · Chronik · Bildarchiv</span>
      <h1>Arbeitskreis Dorfgeschichte Stockhausen</h1>
      <p>Wer die Zukunft des Dorfes gestalten will, muss seine Wurzeln kennen. Der Arbeitskreis erforscht, sammelt und bewahrt die Geschichte von Herbstein-Stockhausen.</p>
    </div>
    <span class="ak-held__foto">Foto: Marc Ahne</span>
  </section>

  <section class="huelle ak">
    <div class="spalten">
      <div>
        <span class="kicker">Was wir tun</span>
        <h2>Das Gedächtnis des Dorfes</h2>
        <p>Ehrenamtliche Heimatforscher und Chronisten – allen voran Hans-Jürgen Döll – sichern Dokumente, Fotos aus Privatbesitz, Kirchenbücher und Gerichtsakten und machen sie der Öffentlichkeit zugänglich.</p>
        <p>Vom mittelalterlichen Gerichtsplatz unter der Linde über die Schlossgeschichte der Freiherren Riedesel bis zu den Lebensgeschichten und Handwerkstraditionen früherer Dorfbewohner: Aus Ahnenforschung, Haus- und Hofchroniken und Erzählungen von Zeitzeugen entsteht ein Bild vom Wandel des Bauerndorfs zur heutigen Dorfgemeinschaft.</p>
        <ul class="themen" aria-label="Themen des Arbeitskreises">
          {themen.map((t) => <li>{t}</li>)}
        </ul>
        <p>Ziel ist ein digitales Bildarchiv mit alten Glasplatten, Ansichtskarten und Vereinsaufnahmen aus den letzten 130 Jahren.</p>
        <p>Die wichtigsten Daten der Ortsgeschichte stehen auf der Seite <a href={url('dorf/')}>Unser Dorf</a>, die ausführliche <a href={url('dorf/chronik/')}>Ortschronik</a> von Hans-Jürgen Döll Jahr für Jahr.</p>
      </div>

      <aside class="seitenleiste">
        <div class="karte kasten">
          <h3>Kontakt</h3>
          <dl class="liste">
            <div><dt>Chronik und Redaktion</dt><dd>Hans-Jürgen Döll</dd></div>
            <div><dt>Webarchiv</dt><dd><a href="https://www.hjdoell.de" rel="noopener">www.hjdoell.de</a></dd></div>
          </dl>
        </div>
        <div class="karte kasten">
          <h3>Treffen</h3>
          <p class="treffen">Am ersten Montagabend im Monat in der Bibliothek in der Altfellhalle.</p>
        </div>
        <div class="karte kasten">
          <h3>Aktive Mitglieder</h3>
          <ul class="namen">
            {aktive.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </aside>
    </div>

    <div class="neu-buch" id="saellemoa">
      <figure class="neu-buch__titel">
        <Image src={saellemoaTitel} alt="Buchtitel „Saellemoa … So war’s einmal … – Geschichte und Geschichten aus Stockhausen“ mit einem kolorierten alten Foto: ein Junge vor Fachwerkhäusern an einer gepflasterten Dorfstraße" widths={[400, 800]} sizes="(max-width: 760px) calc(100vw - 32px), 360px" />
      </figure>
      <div>
        <span class="kicker">Neu · erscheint zum ersten Advent 2026</span>
        <h2>„Saellemoa … – So war’s einmal …“</h2>
        <p class="buch-untertitel">Geschichte und Geschichten aus Stockhausen</p>
        <p>Pünktlich zum ersten Advent erscheint das neue Buch über Stockhausen. Auf über 260 Seiten berichten wir über die Frühgeschichte der Wüstungen rund um Stockhausen, die Reformation im Riedeselischen Land, Erhebungen über Landwirtschaft und Handwerk, wahre Geschichten von einst bis hin zu Lebenserinnerungen von Gisela Mertin und Hanni Möller.</p>
        <p>Geschmückt werden diese Beiträge mit alten Bildern aus den Anfängen der Fotografie und auch neueren Farbaufnahmen sowie Belegen aus Landwirtschaft und Handwerk.</p>
        <div class="karte kasten">
          <dl class="liste">
            <div><dt>Buchvorstellung</dt><dd>Samstag, 28. November 2026, 14:00 Uhr</dd></div>
            <div><dt>Ort</dt><dd>„i Schmidds Soal“ (Lenny’s im Saal), Müser Straße 9</dd></div>
            <div><dt>Erhältlich</dt><dd>bis 4. Dezember täglich 10–12 und 14–17:30 Uhr, danach jeden Freitag 15–18 Uhr in der Bücherei in der Altfellhalle (Sportplatz) – und bei der Volksbank Stockhausen</dd></div>
            <div><dt>Mitarbeit</dt><dd>{aktive.join(', ')}</dd></div>
          </dl>
          <a class="neu-buch__plakat" href={url('plakate/buchvorstellung-saellemoa-2026/')}>Plakat ansehen →</a>
        </div>
      </div>
    </div>

    <div>
      <span class="kicker">Veröffentlichungen</span>
      <h2>Davor erschienen</h2>
      <ul class="buecher">
        {buecher.map((b) => (
          <li class="karte buch-karte">
            <Image src={b.bild} alt={b.alt} widths={[320, 640]} sizes="(max-width: 760px) calc(100vw - 32px), 340px" />
            <div class="buch-karte__text">
              <span class="buch-karte__jahr">{b.jahr}</span>
              <h3>{b.titel}</h3>
              <p class="buch-karte__unter">{b.untertitel}</p>
              <dl class="liste">
                <div><dt>Mitarbeit</dt><dd>{b.mitarbeit.join(', ')}</dd></div>
                {b.daten?.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}
              </dl>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="karte aufruf">
      <span class="kicker">Mitmachen</span>
      <h2>Haben Sie alte Fotos oder Geschichten?</h2>
      <p>Historische Aufnahmen, Schriftstücke oder Erinnerungen aus alten Tagen helfen, das kulturelle Gedächtnis Stockhausens lebendig zu halten. Sprechen Sie den Arbeitskreis an. Wer Interesse an der Mitarbeit im Arbeitskreis hat, ist jederzeit gerne willkommen.</p>
    </div>

    <VereinRueckblicke teil="Dorfgeschichte" />

    {termine.length > 0 && (
      <div>
        <span class="kicker">Termine</span>
        <h2>Demnächst</h2>
        <div class="termine">{termine.map((t) => <TerminKarte termin={t} />)}</div>
      </div>
    )}
  </section>
</Basis>

<style>
  .ak-held { position: relative; isolation: isolate; overflow: hidden; margin-bottom: 2.5rem; color: #fff; }
  .ak-held__bild { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; z-index: -2; }
  .ak-held::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(12 18 24 / 0.82) 0%, rgb(12 18 24 / 0.55) 55%, rgb(12 18 24 / 0.2) 100%);
  }
  .ak-held__foto { position: absolute; right: 16px; bottom: 10px; font-size: 0.75rem; color: rgb(255 255 255 / 0.85); text-shadow: 0 1px 4px rgb(0 0 0 / 0.6); }
  .ak-kopf { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .ak-kopf h1 { color: #fff; max-width: 18ch; text-shadow: 0 2px 20px rgb(0 0 0 / 0.35); }
  .ak-kopf p { font-size: 1.15rem; max-width: 60ch; color: #eef3f6; text-shadow: 0 1px 10px rgb(0 0 0 / 0.4); }
  .ak-kopf .kicker { color: var(--gold); }
  .zurueck { display: block; width: fit-content; margin-bottom: 1.25rem; font-size: 0.9rem; text-decoration: none; color: #fff; }

  .ak { padding-block: 0 5rem; display: grid; gap: 3.5rem; }
  .spalten { display: grid; grid-template-columns: 1fr 320px; gap: 3rem; align-items: start; }
  @media (max-width: 900px) { .spalten { grid-template-columns: 1fr; } }
  .spalten p { max-width: 68ch; }
  .themen { list-style: none; margin: 1.25rem 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .themen li { padding: 0.3rem 0.8rem; border-radius: 999px; background: var(--ziegel-hell); color: var(--ziegel); font-size: 0.85rem; font-weight: 600; }

  .seitenleiste { display: grid; gap: 1rem; }
  .treffen { margin: 0; font-weight: 600; }
  .kasten { padding: 1.5rem; }
  .kasten h3 { margin: 0 0 0.75rem; }
  .liste { margin: 0; display: grid; }
  .liste div { padding: 0.45rem 0; border-bottom: 1px solid var(--linie); }
  .liste div:last-child { border-bottom: 0; }
  .liste dt { font-size: 0.8rem; color: var(--text-leise); }
  .liste dd { margin: 0; font-weight: 600; }

  .namen { list-style: none; margin: 0; padding: 0; display: grid; }
  .namen li { padding: 0.45rem 0; border-bottom: 1px solid var(--linie); font-weight: 600; }
  .namen li:last-child { border-bottom: 0; }
  .neu-buch { display: grid; grid-template-columns: 360px 1fr; gap: 2.5rem; align-items: start; }
  @media (max-width: 760px) { .neu-buch { grid-template-columns: 1fr; gap: 1.5rem; } }
  .neu-buch__titel { margin: 0; }
  .neu-buch__titel img { display: block; width: 100%; height: auto; border-radius: 6px; box-shadow: var(--schatten); }
  .neu-buch p { max-width: 68ch; }
  .neu-buch .kasten { margin-top: 1.25rem; }
  .neu-buch__plakat { display: inline-block; margin-top: 0.75rem; font-weight: 600; }
  .buch-untertitel { margin-top: -0.5rem; font-size: 1.1rem; color: var(--text-leise); }
  .buecher { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; }
  .buch-karte { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .buch-karte img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 0.95; object-fit: cover; }
  .buch-karte__text { padding: 1.1rem 1.25rem 1.25rem; }
  .buch-karte__jahr { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; color: var(--ziegel); }
  .buch-karte h3 { margin: 0.2rem 0 0.25rem; font-size: 1.25rem; }
  .buch-karte__unter { margin: 0 0 0.75rem; color: var(--text-leise); font-size: 0.92rem; }

  .aufruf { padding: clamp(1.75rem, 4vw, 2.5rem); background: var(--ziegel-hell); border-color: color-mix(in srgb, var(--ziegel) 25%, transparent); }
  .aufruf h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .aufruf p { margin: 0; max-width: 60ch; }
  .termine { display: grid; gap: 1rem; margin-top: 1.25rem; }
</style>

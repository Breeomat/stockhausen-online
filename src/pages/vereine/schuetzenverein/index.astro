---
import { Image } from 'astro:assets';
import Basis from '../../../layouts/Basis.astro';
import wappen from '../../../assets/fotos/schuetzenverein-wappen.png';
import luftbild from '../../../assets/fotos/schuetzenhaus-luftbild.jpg';
import TerminKarte from '../../../components/TerminKarte.astro';
import { kommendeTermine } from '../../../lib/termine';
import { url } from '../../../lib/site';

// Quelle: Dossier „Schützenverein Stockhausen Vereinsdossier“ (Drive, Oktober 2026),
// Name, Vereinsnummer und Postanschrift aus dem Vereinsverzeichnis (Screenshot, Oktober 2026)
const termine = (await kommendeTermine()).filter((t) => t.data.verein?.includes('Schützenverein'));

const vorstand = [
  ['1. Vorsitzender', 'Günther Stolze'],
  ['2. Vorsitzender', 'Jens Häuser'],
  ['Rechnerin', 'Magdalena Schmidt'],
  ['Schriftführerin', 'Tina Möller'],
  ['Schießwarte', 'Wolfgang Janich, Klaus Biermann'],
  ['Bogenwart', 'Lothar Stolze'],
];

const disziplinen = [
  { name: 'Luftgewehr 10 m', ebene: 'Bezirksrunde', text: 'Freihand-Schießen: Koordination, Standfestigkeit und ruhige Atmung.' },
  { name: 'Luftgewehr Auflage', ebene: 'Ältestenrunde Vogelsberg', text: 'Präzision im Zehntel-Ringbereich; Seniorenmannschaften im Ligabetrieb.' },
  { name: 'Kleinkaliber 50 m', ebene: 'Bezirks- und Landesmeisterschaften', text: 'Gewehrschießen im Sommerhalbjahr auf 50 Meter.' },
  { name: 'Bogenschießen', ebene: 'Bogenwart: Lothar Stolze', text: 'Neben dem Gewehr wird im Verein auch mit dem Bogen geschossen. Ansprechpartner ist der Bogenwart.' },
  { name: 'Königsschießen', ebene: 'Vereinsintern', text: 'Ermittlung der Schützenkönige und geselliges Pokalschießen.' },
];
---
<Basis bild={luftbild} titel="Schützenverein" beschreibung="KK Schützenverein 1926/68 e.V. Stockhausen: Sportschießen im Schützenbezirk 25 Vogelsberg – Luftgewehr, Auflage, Kleinkaliber, Bogen und Königsschießen.">
  <section class="sch-held">
    <Image class="sch-held__bild" src={luftbild} alt="Das Schützenhaus aus der Luft, umgeben von Bäumen, mit Zufahrt und Parkplatz" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="huelle sch-kopf">
    <div>
      <a class="zurueck" href={url('vereine/')}>← Alle Vereine</a>
      <span class="kicker">Verein · 1926/68 · Schützenbezirk 25 Vogelsberg</span>
      <h1>KK Schützenverein 1926/68 e.V. Stockhausen</h1>
      <p>Sportlicher Ehrgeiz und dörfliche Gemeinschaft: Im Schützenverein stehen Konzentration, Zielsicherheit und Fairness an erster Stelle – für Jugendliche ebenso wie für die Seniorenmannschaften.</p>
    </div>
    <Image class="sch-kopf__wappen" src={wappen} alt="Vereinswappen: zwei gekreuzte Gewehre über einer Zielscheibe, Schrift „K-K Schützenverein Stockhausen“" width={220} />
    </div>
    <span class="sch-held__foto">Schützenhaus am Weinberg aus der Luft · Foto: Marc Ahne</span>
  </section>

  <section class="huelle sch">
    <div class="text">
        <span class="kicker">Sportschießen</span>
        <h2>Präzision und Gemeinschaft</h2>
        <p>Der Verein gehört zum Schützenbezirk 25 Vogelsberg im Hessischen Schützenverband und schießt nach der Sportordnung des Deutschen Schützenbundes. Ein Schwerpunkt ist das Auflageschießen mit Luftgewehr und Kleinkaliber. In Rundenwettkämpfen treffen die Stockhäuser auf Nachbarvereine wie Lanzenhain, Lauterbach, Wallenrod und Herbstein.</p>
        <p>Sportschießen wird hier generationsübergreifend betrieben: Jugendliche und Jungschützen schulen Disziplin und Körperbeherrschung, die Seniorenteams tragen den Ligabetrieb in der Ältestenrunde.</p>
    </div>

    <div>
      <span class="kicker">Disziplinen</span>
      <h2>Was geschossen wird</h2>
      <ul class="disziplinen">
        {disziplinen.map(({ name, ebene, text }) => (
          <li class="karte"><span class="disziplinen__ebene">{ebene}</span><h3>{name}</h3><p>{text}</p></li>
        ))}
      </ul>
    </div>

    <div class="karte aufruf">
      <span class="kicker">Schnupperschießen</span>
      <h2>Einfach mal ausprobieren</h2>
      <p>Wer den Schießsport ausprobieren oder wieder einsteigen möchte, spricht den Verein an. Erfahrene Mitglieder zeigen Neulingen und Jugendlichen den sicheren Umgang mit den Sportgeräten; Vereinsgewehre stehen zum Ausprobieren bereit.</p>
    </div>

    <div class="kaesten">
    <div class="karte kasten">
      <h3>Vorstand</h3>
      <dl class="liste">
        {vorstand.map(([amt, name]) => <div><dt>{amt}</dt><dd>{name}</dd></div>)}
      </dl>
    </div>
    <div class="karte kasten">
      <h3>Kontakt</h3>
      <dl class="liste">
        <div><dt>Postanschrift</dt><dd>Günther Stolze<br />Hintergasse 11, 36358 Herbstein</dd></div>
        <div><dt>Vereinsnummer</dt><dd>2500047</dd></div>
      </dl>
    </div>
    </div>

    {termine.length > 0 && (
      <div>
        <span class="kicker">Termine</span>
        <h2>Demnächst</h2>
        <div class="termine">{termine.map((t) => <TerminKarte termin={t} />)}</div>
      </div>
    )}
  </section>
</Basis>

<style>
  .sch-held { position: relative; isolation: isolate; overflow: hidden; margin-bottom: 2.5rem; color: #fff; }
  .sch-held__bild { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; z-index: -2; }
  .sch-held::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(12 18 24 / 0.85) 0%, rgb(12 18 24 / 0.6) 55%, rgb(12 18 24 / 0.2) 100%); }
  .sch-held__foto { position: absolute; right: 16px; bottom: 10px; font-size: 0.75rem; color: rgb(255 255 255 / 0.85); text-shadow: 0 1px 4px rgb(0 0 0 / 0.6); }
  .sch-kopf { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .sch-kopf h1 { color: #fff; text-shadow: 0 2px 20px rgb(0 0 0 / 0.35); }
  .sch-kopf p { font-size: 1.15rem; max-width: 60ch; color: #eef3f6; text-shadow: 0 1px 10px rgb(0 0 0 / 0.4); }
  .sch-kopf .kicker { color: var(--gold); }
  .zurueck { display: block; width: fit-content; margin-bottom: 1.25rem; font-size: 0.9rem; text-decoration: none; color: #fff; }
  .sch { padding-block: 0 5rem; display: grid; gap: 3.5rem; }
  .text p { max-width: 68ch; }

  .disziplinen { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; }
  .disziplinen li { padding: 1.25rem 1.5rem; border-top: 4px solid var(--ziegel); }
  .disziplinen h3 { margin: 0.3rem 0 0.4rem; font-size: 1.2rem; }
  .disziplinen p { margin: 0; color: var(--text-leise); }
  .disziplinen__ebene { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ziegel); }

  .aufruf { padding: clamp(1.75rem, 4vw, 2.5rem); background: var(--ziegel-hell); border-color: color-mix(in srgb, var(--ziegel) 25%, transparent); }
  .aufruf h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .aufruf p { margin: 0; max-width: 60ch; }
  .sch-kopf { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; }
  .sch-kopf__wappen { width: clamp(110px, 16vw, 200px); height: auto; filter: drop-shadow(0 8px 18px rgb(0 0 0 / 0.25)); }
  @media (max-width: 640px) { .sch-kopf { grid-template-columns: 1fr; gap: 1.25rem; } .sch-kopf__wappen { width: 96px; grid-row: 1; } }
  .kaesten { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1rem; align-items: start; }
  .kasten { padding: 1.5rem; }
  .kasten h3 { margin: 0 0 0.75rem; }
  .liste { margin: 0; display: grid; }
  .liste div { padding: 0.45rem 0; border-bottom: 1px solid var(--linie); }
  .liste div:last-child { border-bottom: 0; }
  .liste dt { font-size: 0.8rem; color: var(--text-leise); }
  .liste dd { margin: 0; font-weight: 600; }
  .termine { display: grid; gap: 1rem; margin-top: 1.25rem; }
</style>

---
import Basis from '../../layouts/Basis.astro';
import VereinKarte from '../../components/VereinKarte.astro';
import { url } from '../../lib/site';
import { vereinsseiten as vereine, weitereVereine, bildFuer } from '../../lib/vereine';

const weitere = await weitereVereine();
---
<Basis titel="Vereine" beschreibung="Die Vereine in Stockhausen: Ansprechpartner, Geschichte und Termine.">
  <section class="huelle seitenkopf">
    <span class="kicker">Vereine</span>
    <h1>Vereine in Stockhausen</h1>
    <p>Hier stellen sich die Vereine aus dem Dorf vor. Weitere Vereinsseiten folgen nach und nach.</p>
  </section>

  <section class="huelle vereine">
    {vereine.map((v) => (
      <VereinKarte name={v.name} kicker={v.seit} text={v.text} href={url(v.href)} linkText="Zur Vereinsseite" bild={v.bild} wappen={v.wappen} />
    ))}
    {weitere.map((name) => (
      <VereinKarte name={name} text="Vereinsseite folgt." href={`${url('termine/')}?verein=${encodeURIComponent(name)}`} linkText="Termine ansehen" bild={bildFuer(name)} />
    ))}
  </section>
</Basis>

<style>
  .vereine { padding-block: 1rem 5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 1rem; }
</style>

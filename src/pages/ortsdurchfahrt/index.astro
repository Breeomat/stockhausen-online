---
import Basis from '../../layouts/Basis.astro';
import { Image } from 'astro:assets';
import { url } from '../../lib/site';
import haltestellenKarte from '../../assets/fotos/ersatzhaltestellen-am-weinberg.jpg';
import haltestellenAnsicht from '../../assets/fotos/ersatzhaltestellen-strassenansicht.jpg';

// Quellen: Mitteilung der Stadtverwaltung Herbstein (Oktober 2026); 2. Bauabschnitt: Herbsteiner Nachrichten, Amtliches
// Bekanntmachungsorgan der Stadt Herbstein (25.11.2026, meinort.app); Ersatzhaltestellen: Lageplan der VGO
---
<Basis titel="Baustelle Ortsdurchfahrt" beschreibung="Erneuerung der Ortsdurchfahrt Stockhausen: Vollsperrung im zweiten Bauabschnitt, Auswirkungen, Ersatzhaltestellen für den Schulbus und Erreichbarkeit von Lädchen und Metzgerei.">
  <section class="huelle seitenkopf">
    <span class="kicker">Baustelle · Mitteilung der Stadtverwaltung</span>
    <h1>Erneuerung der Ortsdurchfahrt</h1>
    <p>Seit Montag, 5. Oktober 2026, wird die Ortsdurchfahrt Stockhausen grundhaft erneuert. Bei der Gemeinschaftsmaßnahme mit HessenMobil werden Fahrbahn und Gehweg sowie Teilstücke der städtischen Versorgungsleitungen erneuert.</p>
  </section>

  <section class="huelle od">
    <p class="karte hinweis-amtlich"><strong>Hinweis:</strong> Diese Seite dient nur der Information und ist keine offizielle Mitteilung der Stadt Herbstein oder des Ortsbeirats Stockhausen. Verbindlich sind die amtlichen Bekanntmachungen der Stadt Herbstein (<a href="https://www.herbstein.de" rel="noopener">herbstein.de</a>, Herbsteiner Nachrichten).</p>
    <div class="karte sperrung">
      <span class="kicker">Vollsperrung · ab Donnerstag, 26. November 2026</span>
      <h2>Zweiter Bauabschnitt</h2>
      <p>Ab Donnerstag, 26. November 2026, laufen die Arbeiten am zweiten Bauabschnitt im Bereich der Müser Straße. Die Arbeiten am Straßenkörper erfolgen unter Vollsperrung: Sie <strong>beginnt im Bereich „Am Weinberg“ und endet nach der Einfahrt zur Schloßstraße</strong>.</p>
      <p class="frueher">Im ersten Bauabschnitt seit 5. Oktober war die Strecke vom Ortseingang aus Richtung Schadges bis zur Einmündung der K 87 („Am Weinberg“) gesperrt.</p>
    </div>

    <div class="karte schulbus" id="schulbus">
      <span class="kicker">Wichtig für den Schulweg</span>
      <h2>Geänderte Schulbushaltestellen</h2>
      <p>Die Haltestellen <strong>„Stockhausen, Ortsmitte“</strong> und <strong>„Stockhausen, Kindergarten“</strong> können von den regulären Busfahrten nicht mehr angefahren werden. Stattdessen gibt es zwei <strong>Ersatzhaltestellen in der Straße „Am Weinberg“</strong> (K 87), auf beiden Straßenseiten zwischen der Einmündung Müser Straße und der Alten Hohl. Bitte berücksichtigt die geänderten Haltestellen bei der Planung des Schulwegs.</p>
      <p>Die Ersatzhaltestellen werden am 25. November aufgestellt. Die VGO bringt zeitgleich an den regulären Haltestellen Fahrgastinformationen und an den Ersatzhaltestellen Fahrpläne an.</p>
      <figure>
        <a href={haltestellenAnsicht.src}><Image src={haltestellenAnsicht} alt="Straßenansicht „Am Weinberg“ in Richtung Ortsmitte: zwei gelbe Punkte markieren die Ersatzhaltestellen links und rechts der Straße" widths={[480, 900]} sizes="(max-width: 900px) calc(100vw - 32px), 860px" /></a>
        <figcaption>Ersatzhaltestelle „Am Weinberg (Ersatz)“ – Blick in Richtung Ortsmitte, die gelben Punkte zeigen die beiden Haltepunkte · Bild: VGO</figcaption>
      </figure>
      <figure>
        <a href={haltestellenKarte.src}><Image src={haltestellenKarte} alt="Karte der VGO: zwei rote Punkte markieren die Ersatzhaltestellen beidseits der Straße „Am Weinberg“ (K 87) auf Höhe der Häuser 2a und 2b, nördlich der Einmündung in die Müser Straße, gegenüber der Evangelischen Kirche" widths={[480, 900]} sizes="(max-width: 900px) calc(100vw - 32px), 860px" /></a>
        <figcaption>Ersatzhaltestellen (rote Punkte) · Karte: Verkehrsgesellschaft Oberhessen (VGO), Kartendaten © OpenStreetMap-Mitwirkende · <a href={url('dorf/karte/#ort-bus-ersatz-weinberg')}>Auf der Dorfkarte</a></figcaption>
      </figure>
      <p class="pdf"><a href={url('baustelle/vgo-ersatzhaltestellen-am-weinberg.pdf')}>Lageplan der VGO als PDF (Straßenansicht, Satellitenbild, Karte)</a></p>
    </div>

    <div class="karte fussweg" id="fussweg">
      <span class="kicker">Zu Fuß</span>
      <h2>Fußweg durch die Baustelle</h2>
      <p>Nach Rücksprache mit dem örtlichen Polier wird der Fußweg auf der Seite des Pfarrhauses und des Friedhofs vorerst nicht zurückgebaut. Anlieger und Schulkinder können auf dieser Seite durch die Baustelle laufen. Wegen der Vollsperrung gibt es dort – bis auf die Baustellenfahrzeuge – kaum Verkehr.</p>
    </div>

    <div>
      <span class="kicker">Was bedeutet das für die Fahrt?</span>
      <h2>Auswirkungen der Sperrung</h2>
      <ul class="auswirkungen">
        <li class="karte nein"><strong>Keine Weiterfahrt nach Blankenau/Fulda:</strong> Wer aus Richtung Lauterbach oder Herbstein/Schadges kommt, kann ab dem 26. November nicht mehr weiter in Richtung Blankenau oder Fulda fahren.</li>
        <li class="karte nein"><strong>Keine Weiterfahrt nach Lauterbach/Herbstein:</strong> Wer aus Richtung Fulda/Blankenau oder Fulda/Großenlüder-Müs kommt, kann ab dem 26. November nicht mehr weiter in Richtung Lauterbach oder Herbstein/Gießen fahren.</li>
        <li class="karte ja"><strong>Freie Fahrt zwischen Lauterbach und Herbstein/Schadges:</strong> Die Strecke bleibt in beiden Richtungen befahrbar – von Lauterbach Richtung Schadges/Herbstein und umgekehrt.</li>
      </ul>
      <p class="klein">Im ersten Bauabschnitt führten die Umleitungen über Blankenau sowie über die K 87 („Am Weinberg“) zur B 275 – sie gelten im zweiten Bauabschnitt nicht mehr.</p>
    </div>

    <div class="karte erreichbar">
      <h2>Tante Enso und Metzgerei Günther</h2>
      <p>Die innerörtliche Anfahrt aus Blankenau oder Müs kommend zur Metzgerei Günther im Mühlweg 3 und zum Ortsladen (<a href={url('tante-enso/')}>Tante Enso</a>) in der Welzgasse 1 ist weiterhin möglich. Aus Richtung Schlechtenwegen, Schadges und Lauterbach sind beide dagegen nicht zu erreichen.</p>
    </div>

    <p class="quelle">Quellen: Mitteilungen der Stadtverwaltung Herbstein (<a href="https://www.herbstein.de/index.html?modules=news&unid=3107&callmode=1" rel="noopener">„Erneuerung der Ortsdurchfahrt Stockhausen – Sperrung und Umleitung“ auf herbstein.de</a>); zweiter Bauabschnitt außerdem: <a href="https://share.meinort.app/vrhHRuaw56upzjWAc" rel="noopener">Herbsteiner Nachrichten, Amtliches Bekanntmachungsorgan der Stadt Herbstein (25.11.2026)</a>; Ersatzhaltestellen: VGO.</p>
  </section>
</Basis>

<style>
  .od { padding-block: 1rem 5rem; display: grid; gap: 2.5rem; }
  .od > * { max-width: 900px; }
  .fussweg { padding: 1.5rem; border-left: 6px solid #2e7d4f; }
  .fussweg h2 { font-size: 1.4rem; }
  .fussweg p { margin: 0; }
  .hinweis-amtlich { margin: 0; padding: 0.9rem 1.2rem; font-size: 0.9rem; color: var(--text-leise); }
  .sperrung { padding: clamp(1.5rem, 4vw, 2.25rem); background: var(--warnung); border-color: var(--warnung-rand); color: var(--warnung-text); }
  .sperrung h2 { color: var(--warnung-text); }
  .sperrung h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); }
  .sperrung p { margin: 0; }
  .sperrung .frueher { margin-top: 0.75rem; font-size: 0.9rem; opacity: 0.85; }
  .schulbus { padding: clamp(1.5rem, 4vw, 2.25rem); border-left: 6px solid var(--lagune); }
  .schulbus h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); }
  .schulbus figure { margin: 1.25rem 0 0; }
  .schulbus img { display: block; width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--linie); }
  .schulbus .pdf { margin: 1rem 0 0; font-weight: 600; }
  .schulbus figcaption { margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-leise); }
  .auswirkungen { margin: 1.25rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.75rem; }
  .auswirkungen li { padding: 1rem 1.25rem 1rem 3.25rem; position: relative; }
  .auswirkungen li::before { position: absolute; left: 1rem; top: 0.95rem; width: 1.6rem; height: 1.6rem; display: grid; place-items: center; border-radius: 50%; color: #fff; font-weight: 700; }
  .auswirkungen .nein::before { content: '✕'; background: #c0232b; }
  .auswirkungen .ja::before { content: '✓'; background: #2e7d4f; }
  .klein { font-size: 0.9rem; color: var(--text-leise); margin: 0.75rem 0 0; }
  .erreichbar { padding: 1.5rem; }
  .erreichbar h2 { font-size: 1.4rem; }
  .erreichbar p { margin: 0; }
  .quelle { font-size: 0.85rem; color: var(--text-leise); margin: 0; }
</style>

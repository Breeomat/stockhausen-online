---
import Basis from '../../layouts/Basis.astro';
import { url } from '../../lib/site';

// Quellen (recherchiert Oktober 2026, vom Betreiber gegenzuprüfen): herbstein.de (Öffnungszeiten, Abfall, Schulen),
// zav-online.de (Abfallkalender, Grünabfall), Wikipedia „Stockhausen (Herbstein)“ (Haltestellen und Linien),
// weiterführende Schulen, Friedhof, Altfellhalle (Mietpreise, Buchung): Angaben des Betreibers (Oktober 2026); Arzt- und Apothekenverzeichnisse (arzt-auskunft.de, apotheke-herbstein-app.de), Schuldatenbank Hessen
const tel = (nummer: string) => 'tel:+49' + nummer.replace(/\D/g, '').replace(/^0/, '');
---
<Basis titel="Neu im Dorf" beschreibung="Neu in Stockhausen? Anmeldung, Müllabfuhr, Bus, Schule, Ärzte, Einkaufen und Vereine – alles Wichtige auf einen Blick.">
  <section class="huelle seitenkopf">
    <span class="kicker">Willkommen</span>
    <h1>Neu in Stockhausen?</h1>
    <p>Schön, dass Sie da sind! Hier steht das Wichtigste für den Anfang – von der Anmeldung über Müllabfuhr und Bus bis zu Ärzten, Einkaufen und den Vereinen im Dorf.</p>
  </section>

  <section class="huelle neu">
    <div class="karte block">
      <span class="kicker">Erste Wege</span>
      <h2>Anmelden und Ansprechpartner</h2>
      <p>Wohnsitz anmelden, Ausweise, Mülltonnen und Zusatzsäcke: zuständig ist das Bürgerbüro der Stadt Herbstein. Termin am besten vorher vereinbaren.</p>
      <dl class="liste">
        <div><dt>Bürgerbüro</dt><dd><span class="eintrag"><span class="eintrag__name">Stadt Herbstein</span><span class="eintrag__info">Rathaus, Marktplatz 7, 36358 Herbstein</span><span class="eintrag__tel">Tel. <a href={tel('06643 9600-0')}>06643 9600-0</a></span><span class="eintrag__tel"><a href="mailto:info@stadt-herbstein.de">info@stadt-herbstein.de</a></span></span></dd></div>
        <div><dt>Öffnungszeiten</dt><dd><span class="eintrag"><span class="eintrag__name">Mo–Fr 8–12 Uhr</span><span class="eintrag__name">Do zusätzlich 13:30–18:30 Uhr</span></span></dd></div>
        <div><dt>Im Dorf</dt><dd><a href={url('ortsbeirat/')}>Ortsbeirat und Ortsvorsteher</a> – für alles, was Stockhausen direkt betrifft</dd></div>
      </dl>
    </div>

    <div class="karte block">
      <span class="kicker">Abfall</span>
      <h2>Müllabfuhr und Grünschnitt</h2>
      <p>Die Abfuhr übernimmt der Zweckverband Abfallwirtschaft Vogelsbergkreis (ZAV). Den persönlichen Abfuhrkalender für die eigene Straße gibt es online und als App „ZAV“ – auf Wunsch mit Erinnerung am Vortag.</p>
      <dl class="liste">
        <div><dt>Abfuhrkalender</dt><dd><a href="https://www.zav-online.de/abfallkalender" rel="noopener">zav-online.de/abfallkalender</a></dd></div>
        <div><dt>Grünschnitt-Sammelplatz Herbstein</dt><dd><span class="eintrag"><span class="eintrag__name">Am Steinbruch (Schrimpf)</span><span class="eintrag__info">Mi 15–17 Uhr · Sa 10–13 Uhr</span></span></dd></div>
        <div><dt>Zusätzliche Restmüllsäcke</dt><dd>im Bürgerbüro Herbstein (9,30 € je Sack)</dd></div>
      </dl>
    </div>

    <div class="karte block">
      <span class="kicker">Unterwegs</span>
      <h2>Bus</h2>
      <p>Stockhausen gehört zum Rhein-Main-Verkehrsverbund (RMV), die Busse fährt die Verkehrsgesellschaft Oberhessen (VGO). Linie VB-28 verbindet das Dorf mit Lauterbach. Wo kein Bus fährt, gibt es das Anruf-Linien-Taxi (ALT) zum RMV-Tarif – vorher anmelden.</p>
      <dl class="liste">
        <div><dt>Stockhausen Ortsmitte</dt><dd>Linien VB-28, VB-42, VB-53 sowie Anruf-Linien-Taxi ALT VB-28 und ALT VB-48</dd></div>
        <div><dt>Fahrplan</dt><dd><a href="https://www.rmv.de" rel="noopener">rmv.de</a> oder App „RMVgo“</dd></div>
      </dl>
    </div>

    <div class="karte block">
      <span class="kicker">Kinder</span>
      <h2>Kindergarten und Schule</h2>
      <dl class="liste">
        <div><dt>Kindergarten</dt><dd><span class="eintrag"><span class="eintrag__name">Ev. Kindergarten „Storchennest“</span><span class="eintrag__info">Müser Straße 27, Stockhausen</span><span class="eintrag__tel">Tel. <a href={tel('06647 333')}>06647 333</a></span></span></dd></div>
        <div><dt>Grundschule</dt><dd><span class="eintrag"><span class="eintrag__name">Freiherr-vom-Stein-Schule</span><span class="eintrag__info">Oelegemer Straße 30, Herbstein</span><span class="eintrag__tel">Tel. <a href={tel('06643 8010')}>06643 8010</a></span><span class="eintrag__zusatz">mit Ganztagsangebot</span></span></dd></div>
        <div><dt>Weiterführende Schulen</dt><dd><span class="eintrag"><span class="eintrag__name">Alexander-von-Humboldt-Schule</span><span class="eintrag__info">Am Eichberg 31, 36341 Lauterbach</span><span class="eintrag__tel">Tel. <a href={tel('06641 6554-0')}>06641 6554-0</a></span><span class="eintrag__zusatz">Gymnasium (Sekundarstufe I und II)</span></span><span class="eintrag"><span class="eintrag__name">Schule an der Wascherde</span><span class="eintrag__info">An der Wascherde 1, 36341 Lauterbach</span><span class="eintrag__tel">Tel. <a href={tel('06641 6556-0')}>06641 6556-0</a></span><span class="eintrag__zusatz">Haupt- und Realschule mit Förderstufe</span></span><span class="eintrag"><span class="eintrag__name">Oberwaldschule Grebenhain</span><span class="eintrag__info">An der Oberwaldschule 2, 36355 Grebenhain</span><span class="eintrag__tel">Tel. <a href={tel('06644 9605-0')}>06644 9605-0</a></span><span class="eintrag__zusatz">Kooperative Gesamtschule (Klassen 5–10)</span></span><span class="eintrag"><span class="eintrag__name">Vogelsbergschule Lauterbach</span><span class="eintrag__info">Lindenstraße 115, 36341 Lauterbach</span><span class="eintrag__tel">Tel. <a href={tel('06641 6555-0')}>06641 6555-0</a></span><span class="eintrag__zusatz">Berufliches Schulzentrum (Berufsschule, FOS, Berufliches Gymnasium)</span></span><span class="eintrag"><span class="eintrag__name">Helmut-von-Bracken-Schule</span><span class="eintrag__info">Hessenstraße 60, 36358 Herbstein</span><span class="eintrag__tel">Tel. <a href={tel('06643 8225')}>06643 8225</a></span><span class="eintrag__zusatz">Förderschule, Standort Herbstein</span></span></dd></div>
      </dl>
    </div>

    <div class="karte block">
      <span class="kicker">Gesundheit</span>
      <h2>Ärzte und Apotheke</h2>
      <dl class="liste">
        <div><dt>Hausärzte in Herbstein</dt><dd><span class="eintrag"><span class="eintrag__name">Dr. med. (univ.) Christine Lamp</span><span class="eintrag__info">Am Scherzacker 8</span><span class="eintrag__tel">Tel. <a href={tel('06643 397')}>06643 397</a></span></span><span class="eintrag"><span class="eintrag__name">Dr. med. Hartmut Roth</span><span class="eintrag__info">Alter Weg 23</span><span class="eintrag__tel">Tel. <a href={tel('06643 292')}>06643 292</a></span></span><span class="eintrag"><span class="eintrag__name">Dr. med. Luise Hengst</span><span class="eintrag__info">Zum Thermalbad 1</span><span class="eintrag__tel">Tel. <a href={tel('06643 7989500')}>06643 798 950 0</a></span></span></dd></div>
        <div><dt>Zahnarzt im Dorf</dt><dd><span class="eintrag"><span class="eintrag__name">Zahnarztpraxis Dr. Carsten Falcke</span><span class="eintrag__info">Müser Straße 49, Stockhausen</span><span class="eintrag__tel">Tel. <a href={tel('06647 234')}>06647 234</a></span><span class="eintrag__zusatz"><a href={url('wer-macht-was/')}>Sprechzeiten unter „Wer macht was“</a></span></span></dd></div>
        <div><dt>Apotheke</dt><dd><span class="eintrag"><span class="eintrag__name">Apotheke in Herbstein</span><span class="eintrag__info">Marktplatz 3, Herbstein</span><span class="eintrag__tel">Tel. <a href={tel('06643 96220')}>06643 96220</a></span></span></dd></div>
        <div><dt>Notfall</dt><dd><span class="eintrag"><span class="eintrag__name">Notruf (Rettungsdienst, Feuerwehr)</span><span class="eintrag__tel">Tel. <a href="tel:112">112</a></span></span><span class="eintrag"><span class="eintrag__name">Ärztlicher Bereitschaftsdienst</span><span class="eintrag__tel">Tel. <a href="tel:116117">116 117</a></span></span></dd></div>
      </dl>
    </div>

    <div class="karte block">
      <span class="kicker">Im Dorf</span>
      <h2>Einkaufen und Mitmachen</h2>
      <p>Lädchen, Metzgerei, Hofladen und Handwerker aus dem Ort stehen unter <a href={url('wer-macht-was/')}>Wer macht was</a>. Am schnellsten kommt man über die Vereine ins Gespräch – ob Feuerwehr, Sportverein, Chor oder Kirmes: Neue sind überall willkommen.</p>
      <dl class="liste">
        <div><dt>Vereine</dt><dd><a href={url('vereine/')}>Alle Vereine in Stockhausen</a></dd></div>
        <div><dt>Termine</dt><dd><a href={url('termine/')}>Was ist los im Dorf</a> – auch als Kalender-Abo fürs Handy</dd></div>
        <div><dt>Altfellhalle mieten (Mehrzweckhalle)</dt><dd><span class="eintrag"><span class="eintrag__name">Buchung: Jürgen Kurz</span><span class="eintrag__info">Bleichstraße 19 · barrierefrei · bis 150 Personen</span><span class="eintrag__tel">Tel. <a href={tel('06647 919007')}>06647 919007</a></span><span class="eintrag__tel">Mobil <a href={tel('0171 5578478')}>0171 55 78 478</a></span><span class="eintrag__zusatz"><a href="#altfellhalle">Ausstattung und Mietpreise ↓</a></span></span></dd></div>
        <div><dt>Friedhof und Bestattungen</dt><dd><span class="eintrag"><span class="eintrag__name">Dominik Frech</span><span class="eintrag__info">Magistrat der Stadt Herbstein, Marktplatz 7, Herbstein</span><span class="eintrag__tel">Tel. <a href={tel('06643 9600-24')}>06643 9600-24</a></span><span class="eintrag__tel"><a href="mailto:buergerbuero@herbstein.de">buergerbuero@herbstein.de</a></span></span></dd></div>
      </dl>
    </div>

    <div class="karte block halle" id="altfellhalle">
      <span class="kicker">Feiern im Dorf</span>
      <h2>Altfellhalle mieten</h2>
      <p>Die Mehrzweckhalle am Sportplatz gehört der Stadt Herbstein und kann für Feiern gemietet werden. Sie ist barrierefrei und bietet Bühne, Küche mit Küchenzeile, Thekenanlage und Kühlung. Großer Saal 289 m², Vereinsraum 43 m², höchstens 150 Personen.</p>
      <table class="preise">
        <thead><tr><th>Raum</th><th>bis 4 Std.</th><th>über 4 Std.</th></tr></thead>
        <tbody>
          <tr><td>Alle Räume</td><td>128,00 €</td><td>185,00 €</td></tr>
          <tr><td>Großer Saal</td><td>85,00 €</td><td>143,00 €</td></tr>
          <tr><td>Teil des großen Saals</td><td>64,00 €</td><td>93,00 €</td></tr>
          <tr><td>Kleiner Saal</td><td>43,00 €</td><td>71,00 €</td></tr>
        </tbody>
      </table>
      <p class="klein-text">Zuzüglich Nebenkosten nach Aufwand gemäß Gebührenordnung der Stadt Herbstein für „Haus des Gastes“, Mehrzweckhallen und Dorfgemeinschaftshäuser. Auch Übungsstunden, Spiele und Wettkämpfe örtlicher Vereine, Verbände, Parteien und Organisationen sind gebührenpflichtig.</p>
      <dl class="liste">
        <div><dt>Buchung</dt><dd><span class="eintrag"><span class="eintrag__name">Jürgen Kurz</span><span class="eintrag__info">Am Weinberg 12, Stockhausen</span><span class="eintrag__tel">Tel. <a href={tel('06647 919007')}>06647 919007</a></span><span class="eintrag__tel">Mobil <a href={tel('0171 5578478')}>0171 55 78 478</a></span><span class="eintrag__info">Fax 06647 919008</span></span></dd></div>
      </dl>
    </div>

    <p class="hinweis-klein">Alle Angaben ohne Gewähr, Stand Oktober 2026. Fehlt etwas oder hat sich etwas geändert? Bitte kurz an <a href="mailto:marc@ahne.de">marc@ahne.de</a>.</p>
  </section>
</Basis>

<style>
  .neu { padding-block: 1rem 5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 1.5rem; align-items: start; }
  .block { padding: clamp(1.25rem, 3vw, 1.75rem); }
  .block h2 { font-size: 1.5rem; margin: 0.2rem 0 0.75rem; }
  .block p { margin: 0 0 1.25rem; color: var(--text-leise); line-height: 1.65; }
  .liste { margin: 0; display: grid; }
  .liste div { padding: 0.8rem 0; border-bottom: 1px solid var(--linie); }
  .liste div:last-child { border-bottom: 0; }
  .liste dt { font-size: 0.8rem; color: var(--text-leise); margin-bottom: 0.25rem; }
  .liste dd { margin: 0; font-weight: 600; line-height: 1.65; overflow-wrap: anywhere; }
  .eintrag { display: block; }
  .eintrag + .eintrag { margin-top: 0.9rem; }
  .eintrag__name { display: block; font-weight: 600; }
  .eintrag__info, .eintrag__zusatz { display: block; font-weight: 400; font-size: 0.95rem; color: var(--text-leise); }
  .eintrag__tel { display: block; font-size: 0.95rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .halle { grid-column: 1 / -1; }
  .preise { width: 100%; max-width: 640px; border-collapse: collapse; margin: 0 0 1rem; font-variant-numeric: tabular-nums; }
  .preise th, .preise td { text-align: left; padding: 0.5rem 0.75rem 0.5rem 0; border-bottom: 1px solid var(--linie); }
  .preise th { font-size: 0.8rem; font-weight: 600; color: var(--text-leise); }
  .preise td:not(:first-child), .preise th:not(:first-child) { text-align: right; white-space: nowrap; padding-left: 0.75rem; }
  @media (max-width: 520px) { .preise { font-size: 0.92rem; } .preise th, .preise td { padding-right: 0.25rem; } .preise td:not(:first-child), .preise th:not(:first-child) { padding-left: 0.5rem; } }
  .klein-text { font-size: 0.9rem; }
  .hinweis-klein { grid-column: 1 / -1; margin: 0.5rem 0 0; font-size: 0.85rem; color: var(--text-leise); }
</style>

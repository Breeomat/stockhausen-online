---
import Basis from '../layouts/Basis.astro';
import Landschaft from '../components/Landschaft.astro';
import TerminKarte from '../components/TerminKarte.astro';
import PlakatRaster from '../components/PlakatRaster.astro';
import { kommendeTermine } from '../lib/termine';
import { plakate } from '../lib/plakate';
import { url } from '../lib/site';
import { aktion, aktionLaeuft } from '../lib/enso';

const naechste = (await kommendeTermine()).slice(0, 4);
const { aktuell } = await plakate();

const demnaechst = [
  { titel: 'Vereine', text: 'Alle Vereine mit Ansprechpartnern, Übungszeiten und eigenen Terminen.' },
  { titel: 'Neuigkeiten', text: 'Was sich im Dorf tut – kurz, aktuell und aus erster Hand.' },
  { titel: 'Damals in Stockhausen', text: 'Alte Fotos, Geschichten und ein Zeitstrahl der Dorfgeschichte.' },
  { titel: 'Ortsbeirat & Gefrierhaus', text: 'Sitzungstermine, Beschlüsse und alles Wichtige rund ums Gefrierhaus.' },
];
---
<Basis>
  <section class="held">
    <div class="huelle held__innen">
      <span class="kicker">36358 Herbstein · Vogelsberg</span>
      <h1>Willkommen in <em>Stockhausen</em></h1>
      <p class="held__text">Was im Dorf los ist: Termine aller Vereine, aktuelle Plakate, Neuigkeiten und Geschichten von früher – an einem Ort.</p>
      <div class="held__knoepfe">
        <a class="knopf" href={url('termine/')}>Nächste Termine</a>
        <a class="knopf knopf--leise" href={url('plakate/')}>Zur Plakatwand</a>
      </div>
    </div>
    <Landschaft />
  </section>

  {aktionLaeuft() && (
    <div class="huelle">
      <a class="hinweis" href={url('tante-enso/')}>
        <span class="hinweis__marke">Lädchen</span>
        <span><strong>Bis {aktion.fristText} braucht das Lädchen {aktion.ziel} Anteile.</strong> Jetzt für Tante Enso mitmachen →</span>
      </a>
    </div>
  )}

  <section class="abschnitt abschnitt--direkt">
    <div class="huelle">
      <div class="kopf-abschnitt">
        <div>
          <span class="kicker">Termine</span>
          <h2>Als Nächstes im Dorf</h2>
        </div>
        <a class="knopf knopf--leise" href={url('termine/')}>Alle Termine</a>
      </div>
      {naechste.length > 0 ? (
        <div class="raster-termine">
          {naechste.map((t) => <TerminKarte termin={t} kompakt />)}
        </div>
      ) : (
        <div class="leer">
          <strong>Der Kalender füllt sich gerade.</strong>
          Die ersten Termine der Vereine werden in Kürze eingetragen.
        </div>
      )}
    </div>
  </section>

  <section class="abschnitt abschnitt--tief">
    <div class="huelle">
      <div class="kopf-abschnitt">
        <div>
          <span class="kicker">Plakatwand</span>
          <h2>Aktuell ausgehängt</h2>
        </div>
        <a class="knopf knopf--leise" href={url('plakate/')}>Alle Plakate</a>
      </div>
      {aktuell.length > 0 ? (
        <PlakatRaster liste={aktuell.slice(0, 4)} />
      ) : (
        <div class="leer">
          <strong>Noch keine Plakate ausgehängt.</strong>
          Hier erscheinen bald die Plakate der Vereine.
        </div>
      )}
    </div>
  </section>

  <section class="abschnitt">
    <div class="huelle zweier">
      <a class="karte enso" href={url('tante-enso/')}>
        <span class="kicker">Einkaufen im Dorf</span>
        <h2>Tante Enso</h2>
        <p>Das Lädchen in der Welzgasse soll ein Tante-Enso-Laden werden: mit Karte rund um die Uhr einkaufen, getragen von Anteilen aus dem Dorf. Alles zum Stand und zum Mitmachen.</p>
        <span class="enso__pfeil">Mehr erfahren →</span>
      </a>
      <div class="karte wissen">
        <span class="kicker">Wussten Sie schon?</span>
        <ul>
          <li><strong>1287</strong><span>wird der Ort als „Stochusen“ zum ersten Mal urkundlich erwähnt.</span></li>
          <li><strong>1770</strong><span>beginnt der Bau des barocken Schlosses der Riedesel – fertig wird es erst 1807.</span></li>
          <li><strong>1847</strong><span>beginnt der Bau der evangelischen Kirche im neuromanischen Stil, 1849 wird sie eingeweiht.</span></li>
        </ul>
        <a class="wissen__mehr" href={url('dorf/')}>Mehr zur Dorfgeschichte →</a>
      </div>
    </div>
  </section>

  <section class="abschnitt abschnitt--tief">
    <div class="huelle">
      <div class="kopf-abschnitt">
        <div>
          <span class="kicker">Die Seite wächst</span>
          <h2>Demnächst hier</h2>
        </div>
      </div>
      <ol class="demnaechst">
        {demnaechst.map(({ titel, text }, i) => (
          <li class="karte">
            <span class="demnaechst__nr">{String(i + 1).padStart(2, '0')}</span>
            <h3>{titel}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Basis>

<style>
  .held {
    background:
      radial-gradient(1200px 500px at 85% -10%, color-mix(in srgb, var(--gold) 22%, transparent), transparent 60%),
      radial-gradient(900px 500px at 0% 0%, color-mix(in srgb, var(--aprikose) 25%, transparent), transparent 60%),
      var(--bg);
  }
  .held__innen { padding-top: clamp(3rem, 9vw, 7rem); }
  .held h1 { max-width: 14ch; margin-bottom: 1.25rem; }
  .held h1 em { font-style: italic; font-weight: 500; color: var(--ziegel); }
  .held__text { font-size: clamp(1.1rem, 1.8vw, 1.3rem); max-width: 46ch; color: var(--text-leise); }
  .held__knoepfe { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .abschnitt--direkt { padding-top: 1rem; }
  .hinweis {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    padding: 0.9rem 1.25rem;
    border-radius: var(--radius);
    background: var(--ziegel-hell);
    color: var(--text);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--ziegel) 30%, transparent);
  }
  .hinweis:hover { color: var(--ziegel); }
  .hinweis__marke {
    flex: none;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--ziegel);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 520px) { .hinweis { flex-direction: column; align-items: flex-start; gap: 0.5rem; } }

  .raster-termine { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 1rem; }

  .zweier { display: grid; grid-template-columns: 1.1fr 1fr; gap: 1.5rem; }
  @media (max-width: 860px) { .zweier { grid-template-columns: 1fr; } }

  .enso {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    text-decoration: none;
    color: #f4efe3;
    background:
      radial-gradient(500px 300px at 100% 100%, color-mix(in srgb, var(--ziegel) 55%, transparent), transparent 70%),
      linear-gradient(140deg, #17405c, #2a6a8c);
    border: 0;
    min-height: 300px;
    transition: transform 0.2s ease;
  }
  .enso:hover { transform: translateY(-3px); color: #fff; }
  .enso .kicker { color: var(--gold); }
  .enso h2 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); }
  .enso p { max-width: 40ch; color: #dce9f1; }
  .enso__pfeil { margin-top: auto; font-weight: 600; color: var(--gold); }

  .wissen { padding: clamp(1.75rem, 4vw, 2.5rem); }
  .wissen ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .wissen li { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; align-items: baseline; }
  .wissen li + li { border-top: 1px solid var(--linie); padding-top: 1.1rem; }
  .wissen strong { font-family: var(--serif); font-size: 1.5rem; color: var(--ziegel); font-weight: 600; }
  .wissen__mehr { display: inline-block; margin-top: 1.25rem; font-weight: 600; }

  .demnaechst { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; }
  .demnaechst li { padding: 1.5rem; }
  .demnaechst__nr { font-family: var(--serif); font-size: 2.2rem; color: var(--ziegel); font-weight: 600; line-height: 1; }
  .demnaechst h3 { margin: 0.75rem 0 0.4rem; }
  .demnaechst p { margin: 0; color: var(--text-leise); font-size: 0.95rem; }
</style>

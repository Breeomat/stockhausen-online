---
import Basis from '../layouts/Basis.astro';
import { Image } from 'astro:assets';
import luftbild from '../assets/fotos/stockhausen-luftbild.jpg';
import TerminKarte from '../components/TerminKarte.astro';
import PlakatRaster from '../components/PlakatRaster.astro';
import { kommendeTermine } from '../lib/termine';
import { plakate } from '../lib/plakate';
import { url } from '../lib/site';
import { aktion, aktionLaeuft, baustelle, baustelleAktiv } from '../lib/enso';
import { vereinsseiten } from '../lib/vereine';
import VereinKarte from '../components/VereinKarte.astro';
import BereichSymbol from '../components/BereichSymbol.astro';
import { getCollection } from 'astro:content';

const naechste = (await kommendeTermine()).slice(0, 4);
const { aktuell } = await plakate();
// Vereine auf der Startseite: vier Stück, im Browser bei jedem Besuch zufällig gewählt.
// Ohne JavaScript (und bis das Skript läuft) wechselt die Auswahl täglich mit dem nächtlichen Neubau.
const VEREINE_START = 4;
const tag = Math.floor(Date.now() / 86_400_000);
const startAuswahl = Array.from({ length: Math.min(VEREINE_START, vereinsseiten.length) }, (_, k) => (tag * VEREINE_START + k) % vereinsseiten.length);
const bereichNamen = { Einkaufen: 'Einkaufen', Gastronomie: 'Essen und Trinken', Handwerk: 'Handwerk', Industrie: 'Industrie und Gewerbe', Landwirtschaft: 'Landwirtschaft', Dienstleistung: 'Dienstleistungen', Einrichtung: 'Einrichtungen' } as const;
const verzeichnis = await getCollection('verzeichnis');
const bereiche = (Object.keys(bereichNamen) as (keyof typeof bereichNamen)[])
  .map((k) => ({ k, anzahl: verzeichnis.filter((e) => e.data.kategorie === k).length }))
  .filter((b) => b.anzahl > 0);
---
<Basis>
  <section class="held">
    <Image class="held__bild" src={luftbild} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="huelle held__innen">
      <span class="kicker">36358 Herbstein · Vogelsberg</span>
      <h1>Willkommen in <em>Stockhausen</em></h1>
      <p class="held__text">Was im Dorf los ist: Termine aller Vereine, aktuelle Plakate, Neuigkeiten und Geschichten von früher – an einem Ort.</p>
    </div>
    <span class="held__foto">Luftbild: Marc Ahne</span>
  </section>

  {baustelleAktiv() && (
    <div class="huelle">
      <a class="hinweis hinweis--baustelle" href={url('ortsdurchfahrt/')}>
        <span class="hinweis__marke">Baustelle</span>
        <span><strong>{baustelle.text}</strong> Umleitungen und Infos →</span>
      </a>
    </div>
  )}

  {aktionLaeuft() && (
    <div class="huelle">
      <a class="hinweis" href={url('tante-enso/')}>
        <span class="hinweis__marke">Lädchen</span>
        <span><strong>Ziel erreicht: {aktion.stand} von {aktion.ziel} Teilhabern fürs Lädchen.</strong> Mitmachen geht noch bis {aktion.fristText} →</span>
      </a>
    </div>
  )}

  <section class="abschnitt abschnitt--direkt">
    <div class="huelle">
      <div class="kopf-abschnitt">
        <div>
          <span class="kicker">Termine</span>
          <h2>Als Nächstes im Dorf</h2>
        </div>
        <a class="knopf knopf--leise" href={url('termine/')}>Alle Termine</a>
      </div>
      {naechste.length > 0 ? (
        <div class="raster-termine">
          {naechste.map((t) => <TerminKarte termin={t} kompakt />)}
        </div>
      ) : (
        <div class="leer">
          <strong>Der Kalender füllt sich gerade.</strong>
          Die ersten Termine der Vereine werden in Kürze eingetragen.
        </div>
      )}
    </div>
  </section>

  <section class="abschnitt vereine-start">
    <div class="huelle">
      <div class="kopf-abschnitt">
        <div>
          <span class="kicker">Vereine</span>
          <h2>Gemeinsam im Dorf</h2>
        </div>
        <a class="knopf knopf--leise" href={url('vereine/')}>Alle Vereine</a>
      </div>
      <div class="vereine-raster" data-anzahl={VEREINE_START}>
        {vereinsseiten.map((v, i) => (
          <div class="verein-platz" hidden={!startAuswahl.includes(i)}>
            <VereinKarte name={v.name} kicker={v.seit} text={v.text} href={url(v.href)} linkText="Zur Vereinsseite" bild={v.bild} wappen={v.wappen} />
          </div>
        ))}
      </div>
      <p class="vereine-mehr">{vereinsseiten.length} Vereine stellen sich vor – bei jedem Besuch erscheinen hier vier andere. <a href={url('vereine/')}>Alle Vereine ansehen →</a></p>
    </div>
  </section>

  <section class="abschnitt wmw-start">
    <div class="huelle">
      <div class="karte wmw">
        <a class="wmw__symbol" href={url('wer-macht-was/')} aria-hidden="true" tabindex="-1"><BereichSymbol name="Laden" groesse={64} /></a>
        <div class="wmw__text">
          <span class="kicker">Wer macht was</span>
          <h2><a href={url('wer-macht-was/')}>Betriebe und Einrichtungen im Dorf</a></h2>
          <p>Einkaufen, einkehren, etwas erledigen: wer im Dorf was anbietet – mit Adresse, Telefon und Öffnungszeiten.</p>
        </div>
        <ul class="wmw__bereiche">
          {bereiche.map(({ k, anzahl }) => (
            <li><a href={`${url('wer-macht-was/')}?bereich=${k}`}><BereichSymbol name={k} groesse={22} /><span>{bereichNamen[k]}</span><small>{anzahl}</small></a></li>
          ))}
          <li><a class="wmw__alle" href={url('wer-macht-was/')}>Zum Verzeichnis →</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="abschnitt abschnitt--tief">
    <div class="huelle">
      <div class="kopf-abschnitt">
        <div>
          <span class="kicker">Plakatwand</span>
          <h2>Aktuell ausgehängt</h2>
        </div>
        <a class="knopf knopf--leise" href={url('plakate/')}>Alle Plakate</a>
      </div>
      {aktuell.length > 0 ? (
        <PlakatRaster liste={aktuell} zeigen={4} fest={2} />
      ) : (
        <div class="leer">
          <strong>Noch keine Plakate ausgehängt.</strong>
          Hier erscheinen bald die Plakate der Vereine.
        </div>
      )}
    </div>
  </section>

  <section class="abschnitt">
    <div class="huelle zweier">
      <a class="karte enso" href={url('tante-enso/')}>
        <span class="kicker">Einkaufen im Dorf</span>
        <h2>Tante Enso</h2>
        <p>Das Lädchen in der Welzgasse wird ein Tante-Enso-Laden: mit Karte rund um die Uhr einkaufen, getragen von Teilhabern aus dem Dorf. Das Ziel von {aktion.ziel} Teilhabern ist erreicht. Alles zum Stand und zum Mitmachen.</p>
        <span class="enso__pfeil">Mehr erfahren →</span>
      </a>
      <div class="karte wissen">
        <span class="kicker">Wussten Sie schon?</span>
        <ul>
          <li><strong>1287</strong><span>wird der Ort als „Stochusen“ zum ersten Mal urkundlich erwähnt.</span></li>
          <li><strong>1770</strong><span>beginnt der Bau des barocken Schlosses der Riedesel – fertig wird es erst 1807.</span></li>
          <li><strong>1841</strong><span>wird hier der erste Kindergarten im damaligen Großherzogtum Hessen gegründet.</span></li>
        </ul>
        <a class="wissen__mehr" href={url('dorf/')}>Mehr zur Dorfgeschichte →</a>
      </div>
    </div>
  </section>
</Basis>

<script>
  // Bei jedem Besuch vier zufällige Vereine zeigen
  const raster = document.querySelector<HTMLElement>('.vereine-raster');
  if (raster) {
    const plaetze = [...raster.querySelectorAll<HTMLElement>('.verein-platz')];
    const anzahl = Number(raster.dataset.anzahl) || 4;
    const gemischt = plaetze.map((p) => ({ p, r: Math.random() })).sort((a, b) => a.r - b.r).map(({ p }) => p);
    const auswahl = new Set(gemischt.slice(0, anzahl));
    plaetze.forEach((p) => (p.hidden = !auswahl.has(p)));
  }
</script>

<style>
  .held {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(480px, 78vh, 760px);
    margin-bottom: 2.5rem;
    overflow: hidden;
    color: #fff;
  }
  .held__bild { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; z-index: -2; }
  .held::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(14 32 48 / 0.78) 0%, rgb(14 32 48 / 0.5) 45%, rgb(14 32 48 / 0.05) 80%),
      linear-gradient(0deg, rgb(14 32 48 / 0.35), transparent 40%);
  }
  .held__innen { padding-block: clamp(3rem, 8vw, 6rem); }
  .held .kicker { color: var(--gold); text-shadow: 0 1px 8px rgb(0 0 0 / 0.4); }
  .held h1 { max-width: 14ch; margin-bottom: 1.25rem; color: #fff; text-shadow: 0 2px 20px rgb(0 0 0 / 0.35); }
  .held h1 em { font-style: italic; font-weight: 500; color: #ffc89e; }
  .held__text { font-size: clamp(1.1rem, 1.8vw, 1.3rem); max-width: 46ch; color: #eef3f6; text-shadow: 0 1px 10px rgb(0 0 0 / 0.4); }
  .held .knopf { background: var(--gold); color: #2a211c; }
  .held .knopf:hover { background: #fff; color: #2a211c; }
  .held .knopf--leise { background: rgb(255 255 255 / 0.12); color: #fff; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.6); backdrop-filter: blur(4px); }
  .held .knopf--leise:hover { background: #fff; color: #2a211c; }
  .held__foto { position: absolute; right: 16px; bottom: 10px; font-size: 0.75rem; color: rgb(255 255 255 / 0.85); text-shadow: 0 1px 4px rgb(0 0 0 / 0.6); }
  @media (max-width: 640px) {
    .held::before { background: linear-gradient(180deg, rgb(14 32 48 / 0.7), rgb(14 32 48 / 0.55)); }
  }
  .abschnitt--direkt { padding-top: 1rem; }
  .hinweis {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    padding: 0.9rem 1.25rem;
    border-radius: var(--radius);
    background: var(--ziegel-hell);
    color: var(--text);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--ziegel) 30%, transparent);
  }
  .hinweis:hover { color: var(--ziegel); }
  .hinweis--baustelle { background: var(--warnung); border-color: var(--warnung-rand); color: var(--warnung-text); }
  .hinweis--baustelle:hover { color: var(--warnung-text); text-decoration: underline; }
  .hinweis--baustelle .hinweis__marke { background: var(--warnung-rand); color: #2a211c; }
  .huelle + .huelle .hinweis { margin-top: 0.6rem; }
  .hinweis__marke {
    flex: none;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--ziegel);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 520px) { .hinweis { flex-direction: column; align-items: flex-start; gap: 0.5rem; } }

  .raster-termine { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 1rem; }

  .zweier { display: grid; grid-template-columns: 1.1fr 1fr; gap: 1.5rem; }
  @media (max-width: 860px) { .zweier { grid-template-columns: 1fr; } }

  .enso {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    text-decoration: none;
    color: #f4efe3;
    background:
      radial-gradient(500px 300px at 100% 100%, color-mix(in srgb, var(--ziegel) 55%, transparent), transparent 70%),
      linear-gradient(140deg, #17405c, #2a6a8c);
    border: 0;
    min-height: 300px;
    transition: transform 0.2s ease;
  }
  .enso:hover { transform: translateY(-3px); color: #fff; }
  .enso .kicker { color: var(--gold); }
  .enso h2 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); }
  .enso p { max-width: 40ch; color: #dce9f1; }
  .enso__pfeil { margin-top: auto; font-weight: 600; color: var(--gold); }

  .vereine-start { padding-top: 0; }
  .wmw-start { padding-top: 0; }
  .wmw { display: grid; grid-template-columns: auto 1fr auto; gap: clamp(1.25rem, 3vw, 2.5rem); align-items: center; padding: clamp(1.5rem, 4vw, 2.5rem); }
  .wmw__symbol { display: grid; place-items: center; width: 112px; height: 112px; border-radius: 50%; background: var(--ziegel-hell); color: var(--ziegel); }
  .wmw__text h2 { margin: 0.25rem 0 0.5rem; }
  .wmw__text h2 a { color: inherit; text-decoration: none; }
  .wmw__text h2 a:hover { color: var(--ziegel); }
  .wmw__text p { margin: 0; color: var(--text-leise); max-width: 48ch; }
  .wmw__bereiche { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; min-width: 240px; }
  .wmw__bereiche a { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.9rem; border-radius: 12px; border: 1px solid var(--linie); background: var(--bg); color: var(--text); text-decoration: none; font-weight: 500; }
  .wmw__bereiche a:hover { border-color: var(--ziegel); color: var(--ziegel); }
  .wmw__bereiche svg { color: var(--ziegel); flex: none; }
  .wmw__bereiche small { margin-left: auto; font-size: 0.8rem; color: var(--text-leise); }
  .wmw__bereiche .wmw__alle { justify-content: center; border: 0; background: var(--meer); color: var(--bg); font-weight: 600; }
  .wmw__bereiche .wmw__alle:hover { background: var(--lagune); color: var(--bg); }
  @media (max-width: 860px) { .wmw { grid-template-columns: auto 1fr; } .wmw__bereiche { grid-column: 1 / -1; min-width: 0; } }
  @media (max-width: 520px) { .wmw { grid-template-columns: 1fr; } .wmw__symbol { width: 84px; height: 84px; } }
  .vereine-raster { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .verein-platz { display: grid; }
  .verein-platz[hidden] { display: none; }
  .vereine-mehr { margin: 1.25rem 0 0; color: var(--text-leise); font-size: 0.95rem; }
  .vereine-mehr a { font-weight: 600; }
  @media (max-width: 640px) { .vereine-raster { grid-template-columns: 1fr; } }
  .wissen { padding: clamp(1.75rem, 4vw, 2.5rem); }
  .wissen ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .wissen li { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; align-items: baseline; }
  .wissen li + li { border-top: 1px solid var(--linie); padding-top: 1.1rem; }
  .wissen strong { font-family: var(--serif); font-size: 1.5rem; color: var(--ziegel); font-weight: 600; }
  .wissen__mehr { display: inline-block; margin-top: 1.25rem; font-weight: 600; }

</style>

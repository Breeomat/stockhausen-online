---
import { Image } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';
import TerminKarte from '../../components/TerminKarte.astro';
import VereinRueckblicke from '../../components/VereinRueckblicke.astro';
import beiratFoto from '../../assets/fotos/ortsbeirat-stockhausen.png';
import { ortsbeirat } from '../../lib/ortsbeirat';
import { kommendeTermine } from '../../lib/termine';
import { url } from '../../lib/site';

// Quelle: Stadt Herbstein, Seite „Ortsbeiräte“ (Oktober 2026) – nur Stockhausen
const termine = (await kommendeTermine()).filter((t) => t.data.verein?.includes('Ortsbeirat'));
const tel = 'tel:+49' + ortsbeirat.telefon.replace(/\D/g, '').replace(/^0/, '');

const aufgaben = [
  'Anhörung zu wichtigen Angelegenheiten, die den Ortsbezirk betreffen',
  'Stellungnahme zum Entwurf des Haushaltsplans, soweit Belange des Ortsbezirks berührt sind',
  'Vorschlagsrecht in Angelegenheiten des Ortsbezirks',
  'Stellungnahmen zu Themen, die Stadtverordnetenversammlung oder Magistrat zur Beratung vorlegen',
];
---
<Basis bild={beiratFoto} titel="Ortsbeirat" beschreibung={`Ortsbeirat Stockhausen ${ortsbeirat.amtszeit}: Mitglieder, Ortsvorsteher Jonas Domaschka, Kontakt und Aufgaben.`}>
  <section class="huelle seitenkopf">
    <span class="kicker">Ortsbezirk Stockhausen · Amtszeit {ortsbeirat.amtszeit}</span>
    <h1>Ortsbeirat Stockhausen</h1>
    <p>Der Ortsbeirat vertritt die Interessen der Bürgerinnen und Bürger von Stockhausen und bringt ihre Anliegen in die Kommunalpolitik der Stadt Herbstein ein. Er ist Ansprechpartner für alles, was das Dorf betrifft.</p>
  </section>

  <section class="huelle ob">
    <div class="spalten">
      <div>
        <figure class="foto">
          <Image src={beiratFoto} alt="Die neun Mitglieder des Ortsbeirats Stockhausen in einem Saal" widths={[400]} sizes="(max-width: 900px) 100vw, 560px" />
          <figcaption>v. l. n. r.: {ortsbeirat.fotoReihe.join(', ')} · Foto: {ortsbeirat.fotoNachweis}</figcaption>
        </figure>

        <h2>Mitglieder</h2>
        <dl class="liste">
          {ortsbeirat.aemter.map(([amt, name]) => <div><dt>{amt}</dt><dd>{name}</dd></div>)}
          <div><dt>Weitere Mitglieder</dt><dd class="weitere">{ortsbeirat.weitere.join(', ')}</dd></div>
        </dl>
      </div>

      <aside class="seitenleiste">
        <div class="karte kasten">
          <h3>Kontakt</h3>
          <dl class="liste">
            <div><dt>Ortsvorsteher</dt><dd>{ortsbeirat.aemter[0][1]}</dd></div>
            <div><dt>Telefon</dt><dd><a href={tel}>{ortsbeirat.telefon}</a></dd></div>
            <div><dt>E-Mail</dt><dd><a href={`mailto:${ortsbeirat.email}`}>{ortsbeirat.email}</a></dd></div>
            <div><dt>Sitzungen</dt><dd>grundsätzlich öffentlich</dd></div>
          </dl>
        </div>
        <div class="karte kasten">
          <h3>Beim Ortsvorsteher</h3>
          <p>Der Ortsvorsteher nimmt als ehrenamtlicher Beauftragter der Stadt Anträge entgegen und stellt Beglaubigungen und Lebensbescheinigungen aus, soweit die Vorschriften das zulassen. Die Gebühren richten sich nach der Verwaltungskostensatzung der Stadt Herbstein.</p>
        </div>
      </aside>
    </div>

    <div>
      <span class="kicker">Aufgaben</span>
      <h2>Was der Ortsbeirat macht</h2>
      <ul class="aufgaben">
        {aufgaben.map((a) => <li class="karte">{a}</li>)}
      </ul>
      <p class="hinweis">Die Aufgaben ergeben sich aus der Hessischen Gemeindeordnung (HGO), der Hauptsatzung der Stadt Herbstein und der Geschäftsordnung für die Ortsbeiräte.</p>
    </div>

    <div class="karte wahl">
      <span class="kicker">Wahl</span>
      <h2>Wie der Ortsbeirat zustande kommt</h2>
      <p>Die Mitglieder werden von den Bürgerinnen und Bürgern des Ortsbezirks bei der Kommunalwahl für fünf Jahre gewählt. Je nach Einwohnerzahl hat ein Ortsbeirat in Herbstein drei bis neun Mitglieder – in Stockhausen sind es neun. Aus ihrer Mitte wählen sie den Ortsvorsteher, der den Vorsitz führt. In allen acht Stadtteilen von Herbstein gibt es einen Ortsbeirat.</p>
    </div>

    <VereinRueckblicke teil="Ortsbeirat" />

    {termine.length > 0 && (
      <div>
        <span class="kicker">Termine</span>
        <h2>Nächste Sitzungen</h2>
        <div class="termine">{termine.map((t) => <TerminKarte termin={t} />)}</div>
      </div>
    )}

    <p class="hinweis">Mehr über das Dorf auf der Seite <a href={url('dorf/')}>Unser Dorf</a>.</p>
  </section>
</Basis>

<style>
  .ob { padding-block: 1rem 5rem; display: grid; gap: 3.5rem; }
  .spalten { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 3rem; align-items: start; }
  @media (max-width: 900px) { .spalten { grid-template-columns: 1fr; } }
  .foto { margin: 0 0 2rem; max-width: 440px; }
  .foto img { width: 100%; height: auto; }
  .foto figcaption { margin-top: 0.5rem; font-size: 0.85rem; color: var(--text-leise); }
  .liste { margin: 0; display: grid; }
  .liste div { padding: 0.55rem 0; border-bottom: 1px solid var(--linie); }
  .liste div:last-child { border-bottom: 0; }
  .liste dt { font-size: 0.8rem; color: var(--text-leise); }
  .liste dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .weitere { font-weight: 500 !important; line-height: 1.5; }
  .seitenleiste { display: grid; gap: 1rem; }
  .kasten { padding: 1.5rem; }
  .kasten h3 { margin: 0 0 0.75rem; }
  .kasten p { margin: 0; color: var(--text-leise); font-size: 0.95rem; }
  .aufgaben { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; }
  .aufgaben li { padding: 1.25rem 1.5rem; border-top: 4px solid var(--ziegel); hyphens: auto; overflow-wrap: break-word; }
  .hinweis { margin: 1rem 0 0; font-size: 0.9rem; color: var(--text-leise); max-width: 70ch; }
  .wahl { padding: clamp(1.75rem, 4vw, 2.5rem); background: var(--ziegel-hell); border-color: color-mix(in srgb, var(--ziegel) 25%, transparent); }
  .wahl p { margin: 0; max-width: 68ch; }
  .termine { display: grid; gap: 1rem; margin-top: 1.25rem; }
</style>

              </figure>
            )}
            <div><h3>{titel}</h3><p>{text}</p></div>
          </article>
        ))}
      </div>
    </div>

    <div>
      <span class="kicker">Rund ums Schloss</span>
      <h2>Leben und Arbeiten mit der Gemeinschaft Altenschlirf</h2>
      <p class="schloss-text">Auf dem Schlossgelände wird gelernt, gewebt, gegärtnert und gefeiert. Auch im „Lädchen für alles“, das die Gemeinschaft Altenschlirf betreibt, gibt es neben dem täglichen Bedarf Produkte aus den eigenen Werkstätten.</p>
      <a class="karte gemeinschaft" href={url('dorf/gemeinschaft-altenschlirf/')}>
        <figure class="sehenswert__bild">
          <Image src={gemeinschaftFoto} alt="Schloss Stockhausen mit Torbau und Uhrturm hinter der Sandsteinmauer des Schlossparks" widths={[480, 680]} sizes="(max-width: 760px) calc(100vw - 32px), 560px" />

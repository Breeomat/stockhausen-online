          <h3>Gemeinschaft Altenschlirf &amp; Campus am Park</h3>
          <p>Anthroposophische Lebens- und Arbeitsgemeinschaft für Menschen mit und ohne Hilfebedarf: Demeter-Landwirtschaft, zwölf Werkstätten, Fachschule für Heilerziehungspflege, Kultur und Märkte im Schlosspark.</p>
          <span class="gemeinschaft__pfeil">Mehr über die Gemeinschaft →</span>
        </div>
      </a>
      <ul class="schloss-leben">
        {schlossLeben.map(({ titel, text }) => <li class="karte"><h3>{titel}</h3><p>{text}</p></li>)}
      </ul>
    </div>


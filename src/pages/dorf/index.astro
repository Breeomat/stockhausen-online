  { jahr: '1603', text: 'Gründung der Freischule.' },
  { jahr: '1680', text: 'Die Riedesel werden in den Freiherrenstand erhoben.' },
  { jahr: '1790', text: 'Baubeginn des barocken Schlosses auf den Mauern der Hermannsburg, unter Baumeister Georg Koch für Friedrich Georg Riedesel.' },

  { jahr: '1894', text: 'Gründung des Gesangvereins „Germania“ als Männergesangverein.' },
  { jahr: '1899', text: 'Ein Großbrand zerstört im Nordosten des Dorfes 22 Wohn- und 33 Nebengebäude.' },

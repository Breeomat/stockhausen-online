---
import Basis from '../../layouts/Basis.astro';

const steckbrief = [
  { wert: '797', text: 'Einwohner (30. Juni 2021)' },
  { wert: '1287', text: 'erste urkundliche Erwähnung' },
  { wert: '1972', text: 'Ortsteil von Herbstein' },
  { wert: '17,72 km²', text: 'Fläche der Gemarkung' },
  { wert: '302 m', text: 'Höhe über Normalhöhennull' },
  { wert: '1841', text: 'ältester Dorfkindergarten im Großherzogtum Hessen' },
];

const daten = [
  ['Postleitzahl', '36358'],
  ['Vorwahl', '06647'],
  ['Koordinaten', '50° 34′ N, 9° 27′ O'],
  ['Einwohner je km²', '45'],
  ['Eingemeindung', '1. August 1972'],
];

const zeitstrahl = [
  { jahr: 'Vorzeit', text: 'Zahlreiche Hügelgräber ringsum und in der Gemarkung zeugen von jahrtausendealter Besiedlung. In geöffneten Gräbern fand man zwei Lanzenspitzen, eine Dolchklinge, zwei Spiralnadeln, eine Nadel, ein Diadem und einen Schlüssel.' },
  { jahr: '1274', text: 'Erste Erwähnung des Nachbardorfs „Bettelenstokhusen“ – Bettler-Stockhausen, im Unterschied zu Kirchstockhausen, dem heutigen Stockhausen. Später wird daraus „Bedelsdorf“ (an anderer Stelle auch „Bedelsburg“).' },
  { jahr: '1287', text: 'Älteste urkundliche Erwähnung: Als „Stochusen“ wird der Ort genannt, als zur Gründung des Klosters Blankenau Güter und Einkünfte in Stockhausen gestiftet werden.' },
  { jahr: '1324', text: 'Eine Urkunde im Archiv in Lauterbach nennt den Ort „Kirchststoghußen“ – zur Unterscheidung vom benachbarten Bettler-Stockhausen.' },
  { jahr: '1428', text: 'Stockhausen ist alter Sitz eines Hoch- oder Blutgerichts. Die Junker Riedesel übernehmen das Gericht Stockhausen.' },
  { jahr: '1465', text: 'In der Fuldisch-Riedeselschen Fehde, auch Steinsche Fehde genannt, werden Stockhausen und Schadges für neutral erklärt – Kloster Blankenau und die Riedesel haben hier beide Besitz. Die meisten anderen Orte des Stockhäuser Gerichts werden zerstört. Wer nach Stockhausen geflohen ist, muss bleiben und dort bauen; das Dorf wächst.' },
  { jahr: '1534', text: 'Die zerstörten Dörfer liegen noch immer wüst. Der Propst von Blankenau beschwert sich über die Riedesel, die dem Kloster Abgaben und Frondienste entzogen haben.' },
  { jahr: '16. Jh.', text: 'Adolph Hermann Riedesel lässt die Hermannsburg erbauen, den Vorgängerbau des heutigen Schlosses.' },
  { jahr: '1603', text: 'Gründung der Freischule.' },
  { jahr: '1680', text: 'Die Riedesel werden in den Freiherrenstand erhoben.' },
  { jahr: '1770', text: 'Baubeginn des barocken Schlosses auf den Mauern der Hermannsburg, unter Baumeister Georg Koch für Friedrich Georg Riedesel.' },
  { jahr: '1801–1807', text: 'Das Schloss wird mit weiteren Umbauten fertiggestellt.' },
  { jahr: '1841', text: 'Gründung des ersten Kindergartens im damaligen Großherzogtum Hessen – des ältesten Dorfkindergartens dort.' },
  { jahr: '1846–1849', text: 'Neubau der evangelischen Kirche als neuromanische Saalkirche anstelle eines älteren Gotteshauses; Einweihung 1849. (Zum Baubeginn nennen die Quellen 1846 oder 1847.)' },
  { jahr: '1852', text: 'Stockhausen gehört nun zum Kreis Lauterbach in der Provinz Oberhessen.' },
  { jahr: '1874', text: 'Gründung der Freiwilligen Feuerwehr Stockhausen.' },
  { jahr: '1880', text: 'Gründung der Spar- und Darlehenskasse Stockhausen.' },
  { jahr: '1894', text: 'Gründung des Gesangvereins „Germania“ als Männergesangverein.' },
  { jahr: '1899', text: 'Ein Großbrand zerstört im Nordosten des Dorfes 22 Wohn- und 33 Nebengebäude. Im selben Jahr wird der Obst- und Gartenbauverein Stockhausen gegründet.' },
  { jahr: '1900', text: 'Gründung des gemischten Chores „Germania“. Das Bürgerliche Gesetzbuch löst die Riedesel’schen Verordnungen ab, die bis dahin als Sonderrecht galten.' },
  { jahr: '1920', text: 'Gründung des Sportvereins Stockhausen.' },
  { jahr: '1946', text: 'Neugründung des Sportvereins Stockhausen.' },
  { jahr: '1972', text: 'Am 1. August wird Stockhausen im Zuge der hessischen Gebietsreform Ortsteil der Stadt Herbstein.' },
  { jahr: '1981', text: 'Stockhausen gehört nun zum Regierungsbezirk Gießen.' },
];

const wuestungen = [
  {
    name: 'Dankenrod',
    text: 'Lag im engen Altefeldtal zwischen Stockhausen und Schlechtenwegen, nahe dem mittelalterlichen Ortesweg. Ein künstlicher Hügel (351 m) deutet auf einen befestigten Hof – im Volk erzählt man von einer Burg der Herren von Dankenrod. Scherben, Hüttenlehm und Eisenschlacken zeugen von drei weiteren Gebäuden und einer Eisenschmelze. Die Flur wird bis heute von Schlechtenwegen und Stockhausen aus bestellt.',
    jahre: 'erwähnt ab 1324, 1556 als Wüstung',
  },
  {
    name: 'Rissbach',
    text: 'Lag unterhalb von Dankenrod am Prinzenbach. 1312 schenkte Mechthildis, Witwe Trabothos von Eisenbach, das Dorf dem Kloster Blankenau. Die Flurnamen „in der Risswich“ und „am Forellenteich“ erinnern noch daran; 1848 kannte man den Namen „Rissbach“ noch.',
    jahre: '1312–1502 belegt',
  },
  {
    name: 'Gersdorf (Gerwigesdorf)',
    text: 'Benannt nach einem Mann namens Gerwig. Die Flur „am Gersters“ am Fuß des Kirchbergs ist der letzte Rest des Dorfes; seine terrassierten Äcker gehören heute zum engsten Stockhäuser Ackerland.',
    jahre: '1323 erstmals genannt',
  },
  {
    name: 'Bedelsdorf (Bettelenstokhusen)',
    text: 'Das „Bettler-Stockhausen“. Wo es lag, ist nicht überliefert. Infrage kommt ein wüster Ortsplatz auf der erhöhten „Hauswiese“ in einer Schleife der Altefeld unterhalb des Dorfes, gleich neben den „Stockackerwiesen“.',
    jahre: '1274 erwähnt',
  },
  {
    name: 'Niederndorf („Nindorf“)',
    text: 'Lag am Eulrichsborn unterhalb des Landenhäuser Steins und wurde in der Fehde zerstört. Später entstand dort wieder ein Hof, der heute noch steht. Der Name Eulrich (Euler = Töpfer) spricht für eine Töpferei. Laut Wikipedia leben dort heute drei Menschen.',
    jahre: 'heute ein Hof',
  },
];

const verwaltung = [
  ['vor 1803', 'Heiliges Römisches Reich, Gericht Stockhausen der Riedesel zu Eisenbach (Mannlehen des Fürstbistums Fulda)'],
  ['ab 1806', 'Großherzogtum Hessen (Souveränitätslande), Fürstentum Starkenburg, Gericht Stockhausen'],
  ['ab 1815', 'Großherzogtum Hessen (Souveränitätslande), Provinz Oberhessen, Amt Altenschlirf'],
  ['ab 1821', 'Großherzogtum Hessen, Provinz Oberhessen, Landratsbezirk Herbstein'],
  ['ab 1825', 'Großherzogtum Hessen, Provinz Oberhessen, Landratsbezirk Lauterbach'],
  ['ab 1848', 'Großherzogtum Hessen, Regierungsbezirk Alsfeld'],
  ['ab 1852', 'Großherzogtum Hessen, Provinz Oberhessen, Kreis Lauterbach'],
  ['ab 1867', 'Norddeutscher Bund, Großherzogtum Hessen, Provinz Oberhessen, Kreis Lauterbach'],
  ['ab 1871', 'Deutsches Reich, Großherzogtum Hessen, Provinz Oberhessen, Kreis Lauterbach'],
  ['ab 1918', 'Deutsches Reich, Volksstaat Hessen, Provinz Oberhessen, Kreis Lauterbach'],
  ['ab 1938', 'Deutsches Reich, Volksstaat Hessen, Kreis Lauterbach'],
  ['ab 1945', 'Amerikanische Besatzungszone, Groß-Hessen, Regierungsbezirk Darmstadt, Kreis Lauterbach'],
  ['ab 1946', 'Amerikanische Besatzungszone, Hessen, Regierungsbezirk Darmstadt, Kreis Lauterbach'],
  ['ab 1949', 'Bundesrepublik Deutschland, Hessen, Regierungsbezirk Darmstadt, Kreis Lauterbach'],
  ['ab 1972', 'Bundesrepublik Deutschland, Hessen, Regierungsbezirk Darmstadt, Vogelsbergkreis, Stadt Herbstein'],
  ['ab 1981', 'Bundesrepublik Deutschland, Hessen, Regierungsbezirk Gießen, Vogelsbergkreis, Stadt Herbstein'],
];

const gerichte = [
  ['ab 1806', 'Riedeselsches Patrimonialgericht Altenschlirf, zweite Instanz Hofgericht Gießen'],
  ['1821–1853', 'Landgericht Altenschlirf'],
  ['ab 1853', 'Landgericht Herbstein'],
  ['ab 1879', 'Amtsgericht Herbstein (Bezirk des Landgerichts Gießen)'],
  ['ab 1943', 'nur noch Zweigstelle des Amtsgerichts Lauterbach'],
  ['ab 1968', 'Amtsgericht Lauterbach'],
];

const einwohner = [
  ['1834', '836'], ['1840', '892'], ['1846', '935'], ['1852', '886'], ['1858', '867'],
  ['1864', '891'], ['1871', '888'], ['1875', '883'], ['1885', '912'], ['1895', '871'],
  ['1905', '834'], ['1910', '848'], ['1925', '776'], ['1939', '715'], ['1946', '1.037'],
  ['1950', '986'], ['1956', '883'], ['1961', '875'], ['1967', '859'], ['2021', '797'],
];

const sehenswert = [
  { titel: 'Schloss Stockhausen', text: 'Barockes Schloss der Riedesel, ab 1770 auf den Mauern der Hermannsburg errichtet und 1807 vollendet. Heute nutzt die Gemeinschaft Altenschlirf die Anlage.' },
  { titel: 'Evangelische Kirche', text: 'Neuromanische Saalkirche, 1849 eingeweiht, ein Kulturdenkmal.' },
  { titel: 'Alte Eiche', text: 'Naturdenkmal mit einem Stammumfang von 6,92 Metern in Brusthöhe (gemessen 2015).' },
];

const entfernungen = [
  ['Schadges', '2 km'],
  ['Hosenfeld-Blankenau', '2 km'],
  ['Großenlüder-Müs', '6 km'],
  ['Rudlos', '6 km'],
  ['Herbstein', '9 km'],
  ['Lauterbach', '11 km'],
  ['Fulda', '22 km'],
];
---
<Basis titel="Unser Dorf" beschreibung="Stockhausen im Vogelsberg: Lage, Geschichte von 1287 bis heute, Einwohner und Sehenswertes.">
  <section class="huelle seitenkopf">
    <span class="kicker">Unser Dorf</span>
    <h1>Stockhausen im Vogelsberg</h1>
    <p>Der größte Ortsteil von Herbstein liegt am Nordostrand des Vogelsbergs und zieht sich entlang der Altefeld. Der Name leitet sich von den Wurzelstöcken und Baumstümpfen ab, die nach einer Rodung stehen blieben. Hier wurde 1841 der älteste Dorfkindergarten im damaligen Großherzogtum Hessen eingerichtet.</p>
  </section>

  <section class="huelle dorf">
    <ul class="steckbrief">
      {steckbrief.map(({ wert, text }) => (
        <li class="karte"><strong>{wert}</strong><span>{text}</span></li>
      ))}
    </ul>

    <div class="spalten">
      <div>
        <span class="kicker">Geschichte</span>
        <h2>Von Stochusen bis heute</h2>
        <ol class="zeitstrahl">
          {zeitstrahl.map(({ jahr, text }) => (
            <li><span class="zeitstrahl__jahr">{jahr}</span><p>{text}</p></li>
          ))}
        </ol>
      </div>

      <aside class="seitenleiste">
        <div class="karte kasten">
          <h3>Einwohner</h3>
          <table>
            <tbody>
              {einwohner.map(([jahr, zahl]) => <tr><th scope="row">{jahr}</th><td>{zahl}</td></tr>)}
            </tbody>
          </table>
          <p class="klein">1961: 749 evangelische und 125 katholische Einwohner. Quelle bis 1967: Historisches Gemeindeverzeichnis für Hessen, Hessisches Statistisches Landesamt 1968.</p>
        </div>
        <div class="karte kasten">
          <h3>Daten</h3>
          <table>
            <tbody>
              {daten.map(([was, wert]) => <tr><th scope="row">{was}</th><td>{wert}</td></tr>)}
            </tbody>
          </table>
        </div>
        <div class="karte kasten">
          <h3>Ortsbeirat</h3>
          <table>
            <tbody>
              <tr><th scope="row">Ortsvorsteher</th><td>Jonas Domaschka</td></tr>
            </tbody>
          </table>
        </div>
        <div class="karte kasten">
          <h3>Nachbarorte</h3>
          <table>
            <tbody>
              {entfernungen.map(([ort, km]) => <tr><th scope="row">{ort}</th><td>{km}</td></tr>)}
            </tbody>
          </table>
        </div>
      </aside>
    </div>

    <div class="wuest">
      <div class="wuest__kopf">
        <span class="kicker">Rund ums Dorf</span>
        <h2>Gute Böden und verschwundene Dörfer</h2>
        <p>Stockhausen liegt im Ostvorland des Vogelsbergs, zum Teil auf Buntsandstein. Im Tal wurden mit die besten Böden der Gegend ermittelt, die Vegetationszeit ist länger als im eigentlichen Vogelsberg – deshalb wachsen hier in geschützter Lage reichlich Obstbäume. Schon im Mittelalter war Stockhausen der größte Ort des Gerichts.</p>
        <p>Kloster Blankenau besaß im Gericht Stockhausen acht Dörfer und Wüstungen: Niederndorf, Bedelsdorf, Gensdorf, Stockhausen, Schadges, Rixdorf (Rixfeld), Reichlos und Rippach. Nach der Fehde von 1465 blieben viele davon wüst; ihre Bewohner wurden in Stockhausen angesiedelt. Einige dieser Orte lassen sich noch in Flurnamen und im Boden finden.</p>
      </div>
      <div class="wuest__raster">
        {wuestungen.map(({ name, text, jahre }) => (
          <article class="karte"><span class="wuest__jahre">{jahre}</span><h3>{name}</h3><p>{text}</p></article>
        ))}
      </div>
    </div>

    <details class="karte mehr">
      <summary><span class="kicker">Zum Nachlesen</span><h2>Verwaltung und Gerichte im Wandel</h2></summary>
      <div class="mehr__inhalt">
        <h3>Zu welchem Staat und Kreis Stockhausen gehörte</h3>
        <dl class="liste">
          {verwaltung.map(([zeit, was]) => <><dt>{zeit}</dt><dd>{was}</dd></>)}
        </dl>
        <h3>Zuständige Gerichte seit 1806</h3>
        <dl class="liste">
          {gerichte.map(([zeit, was]) => <><dt>{zeit}</dt><dd>{was}</dd></>)}
        </dl>
        <h3>Eigenes Recht</h3>
        <p>In Stockhausen galten die Riedesel’schen Verordnungen als Sonderrecht; das allgemeine „Gemeine Recht“ nur dort, wo sie nichts regelten. Formal blieb das auch im Großherzogtum Hessen so, vor Gericht wurden im 19. Jahrhundert aber nur noch einzelne Bestimmungen angewandt. Am 1. Januar 1900 löste das Bürgerliche Gesetzbuch das Sonderrecht ab.</p>
      </div>
    </details>

    <div>
      <span class="kicker">Sehenswert</span>
      <h2>Was man gesehen haben sollte</h2>
      <div class="sehenswert">
        {sehenswert.map(({ titel, text }) => (
          <article class="karte"><h3>{titel}</h3><p>{text}</p></article>
        ))}
      </div>
    </div>

    <p class="quelle">
      Quellen: Wikipedia, Artikel <a href="https://de.wikipedia.org/wiki/Stockhausen_(Herbstein)" rel="noopener">Stockhausen (Herbstein)</a>,
      <a href="https://de.wikipedia.org/wiki/Schloss_Stockhausen" rel="noopener">Schloss Stockhausen</a> und
      <a href="https://de.wikipedia.org/wiki/Evangelische_Kirche_Stockhausen_(Herbstein)" rel="noopener">Evangelische Kirche Stockhausen (Herbstein)</a>
      (Lizenz <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.de" rel="noopener">CC BY-SA 4.0</a>).
    </p>
  </section>
</Basis>

<style>
  .dorf { padding-block: 1rem 5rem; display: grid; gap: 3.5rem; }
  .steckbrief { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .steckbrief li { padding: 1.5rem; display: flex; flex-direction: column; }
  .steckbrief strong { font-family: var(--serif); font-size: clamp(2.2rem, 5vw, 3.2rem); color: var(--ziegel); font-weight: 600; line-height: 1; }
  .steckbrief span { color: var(--text-leise); margin-top: 0.4rem; }

  .spalten { display: grid; grid-template-columns: 1fr 320px; gap: 3rem; align-items: start; }
  @media (max-width: 900px) { .spalten { grid-template-columns: 1fr; } }

  .zeitstrahl { list-style: none; margin: 1.5rem 0 0; padding: 0; position: relative; }
  .zeitstrahl::before { content: ''; position: absolute; left: 0.45rem; top: 0.5rem; bottom: 0.5rem; width: 2px; background: var(--linie); }
  .zeitstrahl li { position: relative; padding: 0 0 1.4rem 2.25rem; }
  .zeitstrahl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--lagune);
  }
  .zeitstrahl__jahr { font-family: var(--serif); font-weight: 600; font-size: 1.2rem; color: var(--ziegel); }
  .zeitstrahl p { margin: 0.15rem 0 0; }

  .seitenleiste { display: grid; gap: 1rem; position: sticky; top: 90px; }
  @media (max-width: 900px) { .seitenleiste { position: static; } }
  .kasten { padding: 1.5rem; }
  .kasten h3 { margin-bottom: 0.75rem; }
  .kasten table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .kasten th, .kasten td { padding: 0.4rem 0; border-bottom: 1px solid var(--linie); }
  .kasten th { text-align: left; font-weight: 500; color: var(--text-leise); }
  .kasten td { text-align: right; font-weight: 600; }
  .klein { font-size: 0.85rem; color: var(--text-leise); margin: 0.75rem 0 0; }

  .sehenswert { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .sehenswert article { padding: 1.5rem; }
  .sehenswert p { margin: 0; color: var(--text-leise); }

  .steckbrief { grid-template-columns: repeat(3, 1fr); }
  .steckbrief strong { white-space: nowrap; }
  @media (max-width: 760px) { .steckbrief { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .steckbrief { grid-template-columns: 1fr; } }
  .mehr { padding: clamp(1.25rem, 3vw, 2rem); }
  .mehr summary { cursor: pointer; list-style: none; }
  .mehr summary::-webkit-details-marker { display: none; }
  .mehr summary h2 { margin: 0; font-size: clamp(1.4rem, 3vw, 1.9rem); }
  .mehr summary h2::after { content: ' +'; color: var(--ziegel); }
  .mehr[open] summary h2::after { content: ' −'; }
  .mehr__inhalt { margin-top: 1.5rem; }
  .mehr__inhalt h3 { margin-top: 1.75rem; }
  .mehr__inhalt h3:first-child { margin-top: 0; }
  .mehr__inhalt p { max-width: 68ch; }
  .liste { display: grid; grid-template-columns: 7rem 1fr; gap: 0.5rem 1.25rem; margin: 0.75rem 0 0; }
  .liste dt { font-weight: 600; color: var(--ziegel); font-variant-numeric: tabular-nums; }
  .liste dd { margin: 0; }
  @media (max-width: 560px) { .liste { grid-template-columns: 1fr; gap: 0.1rem; } .liste dd { margin-bottom: 0.6rem; } }
  .wuest__kopf { max-width: 72ch; }
  .wuest__kopf p { color: var(--text-leise); }
  .wuest__raster { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .wuest__raster article { padding: 1.5rem; }
  .wuest__raster h3 { margin: 0.35rem 0 0.5rem; }
  .wuest__raster p { margin: 0; color: var(--text-leise); }
  .wuest__jahre { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ziegel); }
  .quelle { font-size: 0.85rem; color: var(--text-leise); margin: 0; }
</style>

const sehenswert = [
  {
    titel: 'Schloss Stockhausen',
    text: 'Dreiflügeliges Barockschloss der Riedesel, ab 1790 auf den Mauern der Hermannsburg errichtet und 1807 vollendet. Dazu gehört ein gepflegter Rokoko-Landschaftsgarten, der öffentlich zugänglich ist und von Menschen mit Beeinträchtigung gepflegt wird. Einige der Baumriesen im Park stammen noch aus Samen, die General Riedesel aus dem Nordamerikanischen Unabhängigkeitskrieg mitbrachte. Eigentümerin von Schloss und Park ist heute die Gemeinschaft Altenschlirf.',

---
import { Image } from 'astro:assets';
import Basis from '../../../layouts/Basis.astro';
import schlossFoto from '../../../assets/fotos/gemeinschaft-altenschlirf-schloss.jpg';
import logo from '../../../assets/fotos/gemeinschaft-altenschlirf-logo.png';
import marktFoto from '../../../assets/fotos/johannimarkt.jpg';
import parkFoto from '../../../assets/fotos/schloss-stockhausen-park.jpg';
import TerminKarte from '../../../components/TerminKarte.astro';
import VereinRueckblicke from '../../../components/VereinRueckblicke.astro';
import { kommendeTermine } from '../../../lib/termine';
import { url } from '../../../lib/site';

// Quelle: Dossier „Gemeinschaft Altenschlirf e. V. & Campus am Park“ (Oktober 2026),
// abgeglichen mit den Angaben auf „Unser Dorf“ und öffentlichen Einträgen zur Gemeinschaft;
// Johannimarkt: Angaben und Fotos der Gemeinschaft (Oktober 2026)
const termine = (await kommendeTermine()).filter((t) => t.data.verein?.includes('Altenschlirf'));

const bereiche = [
  { titel: 'Wohnen und Leben', text: 'Hausgemeinschaften mit Assistenz – gelebte Inklusion mitten im Dorf.' },
  { titel: 'Landwirtschaft', text: 'Biologisch-dynamische Demeter-Landwirtschaft rund um Stockhausen: Tierhaltung, Futter- und Getreideanbau sowie Pflege von Hecken, Wiesen und Biotopen.' },
  { titel: 'Handwerk', text: 'Zwölf Werkstätten, darunter Gärtnerei, Käserei, Bäckerei, Holzwerkstatt, Kerzenzieherei und Weberei. Die Naturprodukte gibt es im Hofladen und auf Märkten.' },
  { titel: 'Ausbildung', text: 'Am Campus am Park sitzt seit 2009 die Fachschule für Heilerziehungspflege – staatlich anerkannte Fachkräfteausbildung im Vogelsberg.' },
  { titel: 'Kultur und Feste', text: 'Konzerte, Theater, Lesungen, Seminare und Feste im Schlosspark, dazu jedes Jahr am Wochenende um Johanni der Johannimarkt.' },
];

const stockhausen = [
  { titel: 'Schloss und Schlosspark', text: 'Die Gemeinschaft ist Eigentümerin von Schloss Stockhausen und dem öffentlich zugänglichen Park, den Menschen mit Beeinträchtigung pflegen.' },
  { titel: 'Campus am Park', text: 'Fachschule für Heilerziehungspflege, Tagungsort für Seminare und Fortbildungen; vor Ort wird in Gartenbau, Landschaftspflege, Küche und Hauswirtschaft gearbeitet.' },
  { titel: 'Weberei', text: 'Teppiche, Kissen, Tischwäsche und Küchenhandtücher – auf Wunsch auch Unikate.' },
  { titel: 'Kontiki', text: 'Tagesstrukturgruppe auf dem Schlossgelände.' },
  { titel: 'Demeter-Hofladen', text: 'Hofverkauf der Demeter-Gärtnerei im Gutshof: Gemüse, Kartoffeln, Kräuter, Säfte und Eingemachtes. Mo–Fr 8:30–17 Uhr, Telefon 06647 9606-650.' },
  { titel: 'Lädchen für alles (Tante Enso)', text: 'Dorfladen in der Welzgasse 1: täglicher Bedarf und Produkte aus den eigenen Werkstätten. Er wird ein Tante-Enso-Laden, Betreiber bleibt die Gemeinschaft.' },
];

const johannimarkt = [
  { titel: 'Kunsthandwerk', text: 'Holzprodukte, handgewebte Textilien, gezogene Kerzen und Pflanzen aus den Werkstätten der Gemeinschaft, dazu über 50 ausgewählte Kunsthandwerker aus ganz Deutschland – von Keramik, Korbwaren und Rosen über Naturkleidung, Seifen und Schmuck bis zu Filzkunst und Spielzeug.' },
  { titel: 'Essen und Trinken', text: 'Bio-Backwaren aus der Holzofenbäckerei, Käse aus der Hofkäserei, Eis, Kaffee und Kuchen sowie Herzhaftes vom Grill.' },
  { titel: 'Programm', text: 'Puppenspiel, Gaukelei, Mitmach-Werkstätten für Kinder und Live-Musik im Park.' },
  { titel: 'Das ganze Dorf hilft mit', text: 'Sportverein, Kirmesburschen, Schützenverein und weitere Vereine betreuen gemeinsam mit der Gemeinschaft Grill- und Getränkestände.' },
];
---
<Basis bild={schlossFoto} titel="Gemeinschaft Altenschlirf" beschreibung="Gemeinschaft Altenschlirf e. V. und Campus am Park in Stockhausen: Inklusion, Demeter-Landwirtschaft, Werkstätten, Fachschule und Kultur im Schlosspark.">
  <section class="ga-held">
    <Image class="ga-held__bild" src={schlossFoto} alt="Schloss Stockhausen in der Abendsonne hinter einer Sandsteinmauer mit Steinfiguren" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="huelle ga-kopf">
      <a class="zurueck" href={url('dorf/')}>← Unser Dorf</a>
      <span class="kicker">Lebens- und Arbeitsgemeinschaft · Schloss Stockhausen</span>
      <h1>Gemeinschaft Altenschlirf &amp; Campus am Park</h1>
      <p>Inklusion, ökologische Landwirtschaft und Kultur mitten in Stockhausen. Hier leben, lernen und arbeiten Menschen mit und ohne Hilfebedarf auf Augenhöhe zusammen.</p>
    </div>
    <span class="ga-held__foto">Schloss Stockhausen · Bild: Gemeinschaft Altenschlirf</span>
  </section>

  <section class="huelle ga">
    <div class="spalten">
      <div class="text">
        <span class="kicker">Über die Gemeinschaft</span>
        <h2>Leben, lernen und arbeiten</h2>
        <p>Die Gemeinschaft Altenschlirf e. V. ist eine anthroposophisch orientierte, sozialtherapeutische Lebens- und Arbeitsgemeinschaft für erwachsene Menschen mit und ohne Hilfebedarf. Seit über 40 Jahren verbindet sie gelebte Inklusion, Sozialtherapie und biologisch-dynamisches Wirtschaften.</p>
        <p>Neben dem namensgebenden Nachbarort Altenschlirf prägen in Stockhausen vor allem Schloss und Schlosspark mit dem Campus am Park, die Demeter-Landwirtschaft und die Werkstätten das Dorfbild. Ob in der Ausbildung zur Heilerziehungspflege, in Landwirtschaft und Handwerk oder bei Konzerten und Märkten: Die Gemeinschaft ist ein offener Ort der Begegnung für alle im Dorf.</p>
      </div>

      <aside class="karte kasten">
        <Image class="logo" src={logo} alt="Logo der Gemeinschaft Altenschlirf" width={360} />
        <h3>Standort Stockhausen</h3>
        <dl class="liste">
          <div><dt>Adresse</dt><dd>Müser Straße 1, 36358 Herbstein-Stockhausen</dd></div>
          <div><dt>Telefon</dt><dd><a href="tel:+49664796060">06647 9606-0</a></dd></div>
          <div><dt>Fax</dt><dd>06647 9606-179</dd></div>
        </dl>
        <h3>Standort Altenschlirf</h3>
        <dl class="liste">
          <div><dt>Adresse</dt><dd>Erlenweg 9, 36358 Herbstein-Altenschlirf</dd></div>
          <div><dt>Telefon</dt><dd><a href="tel:+4966437090">06643 709-0</a></dd></div>
          <div><dt>Fax</dt><dd>06643 709-139</dd></div>
        </dl>
        <dl class="liste liste--ende">
          <div><dt>E-Mail</dt><dd><a href="mailto:info@gemeinschaft-altenschlirf.de">info@gemeinschaft-altenschlirf.de</a></dd></div>
          <div><dt>Website</dt><dd><a href="https://gemeinschaft-altenschlirf.de" rel="noopener">gemeinschaft-altenschlirf.de</a></dd></div>
        </dl>
      </aside>
    </div>

    <div>
      <span class="kicker">Tätigkeitsfelder</span>
      <h2>Was die Gemeinschaft macht</h2>
      <ul class="bereiche">
        {bereiche.map(({ titel, text }) => <li class="karte"><h3>{titel}</h3><p>{text}</p></li>)}
      </ul>
    </div>

    <div>
      <span class="kicker">In Stockhausen</span>
      <h2>Rund ums Schloss</h2>
      <ul class="bereiche">
        {stockhausen.map(({ titel, text }) => <li class="karte"><h3>{titel}</h3><p>{text}</p></li>)}
      </ul>
    </div>

    <div class="markt">
      <div class="markt__text">
        <span class="kicker">Jedes Jahr im Juni</span>
        <h2>Johannimarkt im Schlosspark</h2>
        <p>Am Wochenende um den Johannistag wird der Schlosspark zum Marktplatz: Stände unter alten Bäumen, entlang der Schlosswiesen und im Innenhof des Schlosses. Veranstalter ist die Gemeinschaft Altenschlirf, gemeinsam mit den Stockhäuser Vereinen. Der zweitägige Kunsthandwerker- und Sommermarkt zieht Besucher aus dem ganzen Vogelsberg und darüber hinaus an.</p>
        <dl class="liste">
          <div><dt>Wann</dt><dd>Samstag und Sonntag am Wochenende um Johanni, jeweils 11–18 Uhr</dd></div>
          <div><dt>Wo</dt><dd>Schlosspark und Campus am Park, Müser Straße 1</dd></div>
          <div><dt>Parken</dt><dd>An den Ortseingängen</dd></div>
        </dl>
      </div>
      <figure class="markt__bild">
        <Image src={marktFoto} alt="Besucher auf dem Weg durch den Schlosspark, links Marktstände mit weißen Zelten vor dem Schloss, rechts ein Holzhäuschen unter einem großen Baum" widths={[480, 680]} sizes="(max-width: 900px) calc(100vw - 32px), 560px" />
        <figcaption>Johannimarkt im Schlosspark · Foto: Gemeinschaft Altenschlirf</figcaption>
      </figure>
      <ul class="bereiche markt__liste">
        {johannimarkt.map(({ titel, text }) => <li class="karte"><h3>{titel}</h3><p>{text}</p></li>)}
      </ul>
      <figure class="markt__kulisse">
        <Image src={parkFoto} alt="Schloss Stockhausen von der Parkseite: langgestreckter Bau mit Mittelrisalit, Dachreiter und Veranda, davor eine große Rasenfläche" widths={[640, 1024, 1600]} sizes="(max-width: 1192px) calc(100vw - 32px), 1160px" />
        <figcaption>Die Kulisse: Schloss Stockhausen von der Parkseite · Foto: Gemeinschaft Altenschlirf</figcaption>
      </figure>
    </div>

    <VereinRueckblicke teil="Altenschlirf" />

    {termine.length > 0 && (
      <div>
        <span class="kicker">Termine</span>
        <h2>Demnächst</h2>
        <div class="termine">{termine.map((t) => <TerminKarte termin={t} />)}</div>
      </div>
    )}
  </section>
</Basis>

<style>
  .ga-held { position: relative; isolation: isolate; overflow: hidden; margin-bottom: 2.5rem; color: #fff; }
  .ga-held__bild { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; z-index: -2; }
  .ga-held::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(12 18 24 / 0.82) 0%, rgb(12 18 24 / 0.55) 55%, rgb(12 18 24 / 0.2) 100%); }
  .ga-held__foto { position: absolute; right: 16px; bottom: 10px; font-size: 0.75rem; color: rgb(255 255 255 / 0.85); text-shadow: 0 1px 4px rgb(0 0 0 / 0.6); }
  .ga-kopf { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .ga-kopf h1 { color: #fff; max-width: 20ch; text-shadow: 0 2px 20px rgb(0 0 0 / 0.35); }
  .ga-kopf p { font-size: 1.15rem; max-width: 60ch; color: #eef3f6; text-shadow: 0 1px 10px rgb(0 0 0 / 0.4); }
  .ga-kopf .kicker { color: var(--gold); }
  .zurueck { display: block; width: fit-content; margin-bottom: 1.25rem; font-size: 0.9rem; text-decoration: none; color: #fff; }

  .ga { padding-block: 0 5rem; display: grid; gap: 3.5rem; }
  .spalten { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 3rem; align-items: start; }
  @media (max-width: 900px) { .spalten { grid-template-columns: 1fr; } }
  .text p { max-width: 68ch; }
  .kasten { padding: 1.5rem; }
  .kasten h3 { margin: 1.25rem 0 0.5rem; }
  .logo { display: block; width: 180px; height: auto; margin-bottom: 0.5rem; }
  .liste--ende { margin-top: 1rem; border-top: 1px solid var(--linie); }
  .liste { margin: 0; display: grid; }
  .liste div { padding: 0.45rem 0; border-bottom: 1px solid var(--linie); }
  .liste div:last-child { border-bottom: 0; }
  .liste dt { font-size: 0.8rem; color: var(--text-leise); }
  .liste dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .bereiche { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; }
  .bereiche li { padding: 1.25rem 1.5rem; border-top: 4px solid var(--ziegel); }
  .bereiche h3 { margin: 0 0 0.4rem; font-size: 1.2rem; }
  .bereiche p { margin: 0; color: var(--text-leise); }
  .termine { display: grid; gap: 1rem; margin-top: 1.25rem; }
  .markt { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem 3rem; align-items: start; }
  .markt__text p { max-width: 68ch; }
  .markt__liste, .markt__kulisse { grid-column: 1 / -1; }
  .markt__liste { margin-top: 0; }
  .markt figure { margin: 0; }
  .markt img { width: 100%; height: auto; border-radius: var(--radius, 12px); }
  .markt__kulisse img { aspect-ratio: 16 / 7; object-fit: cover; object-position: 50% 45%; }
  .markt figcaption { margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-leise); }
  @media (max-width: 900px) { .markt { grid-template-columns: 1fr; } .markt__kulisse img { aspect-ratio: 4 / 3; } }
</style>

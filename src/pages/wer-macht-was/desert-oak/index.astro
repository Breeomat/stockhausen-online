---
import { Image } from 'astro:assets';
import Basis from '../../../layouts/Basis.astro';
import bandFoto from '../../../assets/fotos/desert-oak-band.jpg';
import logo from '../../../assets/fotos/desert-oak-logo.jpg';
import TerminKarte from '../../../components/TerminKarte.astro';
import { kommendeTermine } from '../../../lib/termine';
import { url } from '../../../lib/site';

// Quelle: Pressetext von Desert Oak (Oktober 2026); Fotos und Logo: Desert Oak
const termine = (await kommendeTermine()).filter((t) => t.data.verein?.includes('Desert Oak'));

const kacheln = [
  { titel: 'Von AC/DC bis Linkin Park', text: 'Rockklassiker und neuere Songs von den 1970ern bis heute – von AC/DC über Die Toten Hosen und Metallica bis Pink, Volbeat und Linkin Park.' },
  { titel: 'Unterwegs in der Region', text: 'Seit über 20 Jahren auf Veranstaltungen rund um den Vogelsberg – von der Rhön bis nach Limburg.' },
  { titel: 'Der Name', text: 'Er stammt aus dem Song „Beds Are Burning“ der australischen Rockband Midnight Oil – damit war die Richtung vorgegeben.' },
];

const besetzung = [
  { name: 'Carsten „Casi“ Schwarz', rolle: 'Gesang', seit: 'seit der Gründung' },
  { name: 'Inga Lenzer', rolle: 'Gesang', seit: 'seit 2022, aus Michelbach' },
  { name: 'Carsten Biermann', rolle: 'Gitarre', seit: 'seit der Gründung' },
  { name: 'Philip Hoppe', rolle: 'Gitarre', seit: 'seit 2005' },
  { name: 'Konstantin „Gustav“ Metzker', rolle: 'Bass', seit: 'seit der Gründung' },
  { name: 'Tobias Haas', rolle: 'Schlagzeug', seit: 'seit 2015, aus Breungeshain' },
  { name: 'Bernd Muth', rolle: 'Keyboard, Gitarre, Geige und Technik', seit: 'seit der Gründung' },
];
---
<Basis bild={bandFoto} titel="Desert Oak" beschreibung="Desert Oak: Rock aus Stockhausen seit 2004 – sieben Musiker, Rockklassiker und neuere Songs, live von der Rhön bis Limburg.">
  <section class="do-held">
    <Image class="do-held__bild" src={bandFoto} alt="" widths={[640, 1024, 1170]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="huelle do-kopf">
      <a class="zurueck" href={url('wer-macht-was/')}>← Wer macht was</a>
      <span class="kicker">Rockband · seit 2004</span>
      <h1>Desert Oak</h1>
      <p>Rock aus Stockhausen mit ordentlich Dampf: handgemachte Musik, jede Menge Spielfreude und eine bunte Mischung aus Rockklassikern und neueren Songs.</p>
    </div>
    <span class="do-held__foto">Foto: Desert Oak</span>
  </section>

  <section class="huelle do">
    <ul class="kacheln">
      {kacheln.map(({ titel, text }) => <li class="karte"><h3>{titel}</h3><p>{text}</p></li>)}
    </ul>

    <div class="spalten">
      <div class="text">
        <span class="kicker">Besetzung</span>
        <h2>Sieben Musiker, ein Sound</h2>
        <p>„Und manchmal sieben Meinungen“, sagt die Band selbst. Vier der sieben sind seit der Gründung 2004 dabei.</p>
        <ul class="besetzung">
          {besetzung.map(({ name, rolle, seit }) => (
            <li><span class="besetzung__name">{name}</span><span class="besetzung__rolle">{rolle}</span><span class="besetzung__seit">{seit}</span></li>
          ))}
        </ul>

        <span class="kicker abstand">Proberaum</span>
        <h2>Hauptquartier: ein alter Stall</h2>
        <p>Geprobt wird im Steinweg in Stockhausen, bei Bassist Gustav. Den alten Stall im Erdgeschoss seines Fachwerkhauses hat er komplett kernsaniert und zum Proberaum umgebaut. Wo früher vermutlich ganz andere Geräusche zu hören waren, gibt es heute Gitarrenriffs, Schlagzeugbeats – und gelegentlich Diskussionen darüber, wie ein Song eigentlich richtig gespielt wird.</p>
        <p class="zitat">„Desert Oak – sieben Leute, jede Menge Rock und immer bereit für den nächsten Auftritt. Wir sehen uns vor der Bühne!“</p>
      </div>
      <aside class="karte kasten">
        <Image class="logo" src={logo} alt="Logo von Desert Oak: weißer Baum in einem Kreis aus Stacheldraht, darüber der Schriftzug in gebrochener Schrift" width={360} />
        <h3>Kontakt und Termine</h3>
        <p>Aktuelle Auftritte stehen auf der Facebook-Seite der Band.</p>
        <dl class="liste">
          <div><dt>Booking</dt><dd><span class="fehlt">[fehlt: Ansprechperson, E-Mail oder Telefon]</span></dd></div>
          <div><dt>Facebook</dt><dd><span class="fehlt">[fehlt: Link zur Facebook-Seite]</span></dd></div>
        </dl>
      </aside>
    </div>

    {termine.length > 0 && (
      <div>
        <span class="kicker">Termine</span>
        <h2>Demnächst</h2>
        <div class="termine">{termine.map((t) => <TerminKarte termin={t} />)}</div>
      </div>
    )}
  </section>
</Basis>

<style>
  .do-held { position: relative; isolation: isolate; overflow: hidden; margin-bottom: 2.5rem; color: #fff; }
  .do-held__bild { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; z-index: -2; }
  .do-held::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(12 18 24 / 0.88) 0%, rgb(12 18 24 / 0.65) 50%, rgb(12 18 24 / 0.15) 100%); }
  .do-held__foto { position: absolute; right: 16px; bottom: 10px; font-size: 0.75rem; color: rgb(255 255 255 / 0.85); text-shadow: 0 1px 4px rgb(0 0 0 / 0.6); }
  .do-kopf { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .do-kopf h1 { color: #fff; text-shadow: 0 2px 20px rgb(0 0 0 / 0.35); }
  .do-kopf p { font-size: 1.15rem; max-width: 52ch; color: #eef3f6; text-shadow: 0 1px 10px rgb(0 0 0 / 0.4); }
  .do-kopf .kicker { color: var(--gold); }
  .zurueck { display: block; width: fit-content; margin-bottom: 1.25rem; font-size: 0.9rem; text-decoration: none; color: #fff; }
  .do { padding-block: 0 5rem; display: grid; gap: 3.5rem; }
  .kacheln { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; }
  .kacheln li { padding: 1.25rem 1.5rem; border-top: 4px solid var(--ziegel); }
  .kacheln h3 { margin: 0 0 0.4rem; font-size: 1.2rem; }
  .kacheln p { margin: 0; color: var(--text-leise); }
  .spalten { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 3rem; align-items: start; }
  @media (max-width: 900px) { .spalten { grid-template-columns: 1fr; } }
  .text p { max-width: 68ch; line-height: 1.7; }
  .abstand { display: block; margin-top: 3rem; }
  .besetzung { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 0.75rem; }
  .besetzung li { padding: 0.9rem 1rem; border: 1px solid var(--linie); border-radius: 10px; background: var(--flaeche); display: flex; flex-direction: column; gap: 0.15rem; }
  .besetzung__name { font-weight: 600; }
  .besetzung__rolle { color: var(--ziegel); font-size: 0.92rem; font-weight: 600; }
  .besetzung__seit { color: var(--text-leise); font-size: 0.88rem; }
  .zitat { font-family: var(--serif); font-size: 1.25rem; color: var(--meer); margin-top: 1.5rem; }
  .kasten { padding: 1.5rem; }
  .kasten h3 { margin: 1rem 0 0.5rem; }
  .kasten p { margin: 0 0 0.75rem; color: var(--text-leise); }
  .logo { display: block; width: 100%; height: auto; border-radius: 8px; }
  .liste { margin: 0; display: grid; }
  .liste div { padding: 0.6rem 0; border-bottom: 1px solid var(--linie); }
  .liste div:last-child { border-bottom: 0; }
  .liste dt { font-size: 0.8rem; color: var(--text-leise); }
  .liste dd { margin: 0; font-weight: 600; }
  .termine { display: grid; gap: 1rem; margin-top: 1.25rem; }
</style>

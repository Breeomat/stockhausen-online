---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Basis from '../../layouts/Basis.astro';
import { url } from '../../lib/site';
import { heute } from '../../lib/termine';
import BereichSymbol from '../../components/BereichSymbol.astro';

const reihenfolge = ['Einkaufen', 'Gastronomie', 'Handwerk', 'Industrie', 'Landwirtschaft', 'Gesundheit', 'Dienstleistung', 'Kultur', 'Einrichtung'] as const;
const ueberschrift: Record<(typeof reihenfolge)[number], string> = {
  Einkaufen: 'Einkaufen',
  Gastronomie: 'Essen und Trinken',
  Handwerk: 'Handwerk',
  Industrie: 'Industrie und Gewerbe',
  Landwirtschaft: 'Landwirtschaft',
  Gesundheit: 'Gesundheit',
  Dienstleistung: 'Dienstleistungen',
  Kultur: 'Kultur und Musik',
  Einrichtung: 'Einrichtungen',
};

const eintraege = (await getCollection('verzeichnis')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'de'));
const gruppen = reihenfolge
  .map((k) => [k, eintraege.filter((e) => e.data.kategorie === k)] as const)
  .filter(([, liste]) => liste.length > 0);
const bilder = import.meta.glob<{ default: ImageMetadata }>('../../assets/verzeichnis/*.{jpg,jpeg,png,webp}', { eager: true });
const bildFuer = (datei?: string) => {
  if (!datei) return undefined;
  const b = bilder[`../../assets/verzeichnis/${datei}`];
  if (!b) throw new Error(`Verzeichnis: Bild src/assets/verzeichnis/${datei} fehlt`);
  return b.default;
};
// Telefon/E-Mail: einzeln oder als Liste, optionaler Hinweis in Klammern („06647 1234 (Saal)“)
const alsListe = (wert?: string | string[]) => (wert === undefined ? [] : Array.isArray(wert) ? wert : [wert]);
const teile = (eintrag: string) => {
  const m = eintrag.match(/^(.*?)\s*\(([^)]*)\)\s*$/);
  return m ? { wert: m[1], hinweis: m[2] } : { wert: eintrag, hinweis: undefined };
};
// Website-Link lesbar: Facebook/Instagram als „<Name> auf Facebook“, sonst nur die Domain
const sozial = (web: string) => (/facebook\.com/.test(web) ? 'Facebook' : /instagram\.com/.test(web) ? 'Instagram' : null);
const webArt = (web: string) => sozial(web) ?? 'Website';
const webText = (web: string, name: string) => {
  const netz = sozial(web);
  return netz ? `${name} auf ${netz}` : new URL(web).hostname;
};
const tel = (nummer: string) => 'tel:+49' + nummer.replace(/\D/g, '').replace(/^0/, '');
---
<Basis titel="Wer macht was" beschreibung="Betriebe und Einrichtungen in Stockhausen: Einkaufen, Gastronomie, Handwerk, Landwirtschaft und Dienstleistungen.">
  <section class="huelle seitenkopf">
    <span class="kicker">Wer macht was</span>
    <h1>Betriebe und Einrichtungen</h1>
    <p>Wo man im Dorf einkaufen, einkehren und etwas erledigen kann – mit Adresse und Telefon. Die Vereine stehen unter <a href={url('vereine/')}>Vereine</a>.</p>
  </section>

  <section class="huelle verzeichnis">
    {gruppen.length > 1 && (
      <div class="filter" role="group" aria-label="Nach Bereich filtern">
        <button class="filter__chip" aria-pressed="true" data-filter="">Alle</button>
        {gruppen.map(([k]) => <button class="filter__chip" aria-pressed="false" data-filter={k}><BereichSymbol name={k} groesse={18} />{ueberschrift[k]}</button>)}
      </div>
    )}

    {gruppen.map(([k, liste]) => (
      <section class="gruppe" data-kategorie={k}>
        <h2><BereichSymbol name={k} groesse={26} class="gruppe__symbol" />{ueberschrift[k]}</h2>
        <ul class="eintraege">
          {liste.map(({ data: e }) => (
            <li class:list={['karte eintrag', { 'eintrag--bild': e.bild }]}>
              {e.bild && <Image class="eintrag__bild" src={bildFuer(e.bild)!} alt={e.name} widths={[400, 720]} sizes="(max-width: 760px) 100vw, 380px" />}
              <h3>{e.name}</h3>
              <p>{e.text}</p>
              <dl class="angaben">
                {e.adresse && <div><dt>Adresse</dt><dd>{e.adresse}</dd></div>}
                {e.zeiten && <div><dt>{e.kategorie === 'Gesundheit' ? 'Sprechzeiten' : e.kategorie === 'Industrie' ? 'Bürozeiten' : 'Geöffnet'}</dt><dd>{e.zeiten}</dd></div>}
                {e.telefon && <div><dt>Telefon</dt>{alsListe(e.telefon).map(teile).map(({ wert, hinweis }) => <dd><a href={tel(wert)}>{wert}</a>{hinweis && <small> ({hinweis})</small>}</dd>)}</div>}
                {e.fax && <div><dt>Fax</dt><dd>{e.fax}</dd></div>}
                {e.email && <div><dt>E-Mail</dt>{alsListe(e.email).map(teile).map(({ wert, hinweis }) => <dd><a href={`mailto:${wert}`}>{wert}</a>{hinweis && <small> ({hinweis})</small>}</dd>)}</div>}
                {e.web && <div><dt>{webArt(e.web)}</dt><dd><a href={e.web} rel="noopener">{webText(e.web, e.name)}</a></dd></div>}
              </dl>
              {e.angebot && e.angebot.bis >= heute() && <a class="knopf knopf--leise eintrag__angebot" href={url(e.angebot.datei)}>{e.angebot.titel} ansehen</a>}
              {e.bestellen && <a class="knopf eintrag__bestellen" href={e.bestellen} rel="noopener">Online bestellen</a>}
              {e.seite && <a class="eintrag__mehr" href={url(e.seite)}>Mehr erfahren →</a>}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <aside class="karte hinweis">
      <h2>Ihr Betrieb fehlt?</h2>
      <p>Handwerk, Hofladen, Gaststätte oder Dienstleistung aus Stockhausen: Schicken Sie Name, eine kurze Beschreibung, Adresse, Telefon und Ihr Logo an <a href="mailto:marc@ahne.de">marc@ahne.de</a> – der Eintrag ist kostenlos.</p>
      <p>Für eine eigene Seite (z. B. bei größeren Einrichtungen) zusätzlich eine ausführliche Beschreibung und einige Bilder.</p>
    </aside>
  </section>
</Basis>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter__chip');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const wahl = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      document.querySelectorAll<HTMLElement>('.gruppe').forEach((g) => {
        g.hidden = Boolean(wahl) && g.dataset.kategorie !== wahl;
      });
    }),
  );
  // Link mit ?bereich=… (z. B. von der Startseite) wählt den passenden Filter vor
  const bereich = new URLSearchParams(location.search).get('bereich');
  if (bereich) [...chips].find((c) => c.dataset.filter === bereich)?.click();
</script>

<style>
  .verzeichnis { padding-bottom: 5rem; }
  .filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 1rem; }
  .filter__chip {
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--linie);
    background: var(--flaeche);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .filter__chip[aria-pressed='true'] { background: var(--meer); color: var(--bg); border-color: var(--meer); }
  .gruppe { margin-top: 2.5rem; }
  .gruppe h2 { display: flex; align-items: center; gap: 0.6rem; font-size: 1.5rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--linie); margin-bottom: 1.25rem; }
  .gruppe__symbol { color: var(--ziegel); flex: none; }
  .eintraege { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 1rem; }
  .eintrag { padding: 1.25rem 1.5rem; display: flex; flex-direction: column; }
  .eintrag--bild { overflow: hidden; }
  .eintrag__bild { display: block; width: calc(100% + 3rem); max-width: none; height: auto; margin: -1.25rem -1.5rem 1rem; }
  .eintrag h3 { margin: 0 0 0.4rem; font-size: 1.2rem; }
  .eintrag > p { margin: 0 0 0.75rem; color: var(--text-leise); }
  .angaben { margin: 0 0 0.75rem; display: grid; }
  .angaben div { padding: 0.35rem 0; border-bottom: 1px solid var(--linie); }
  .angaben div:last-child { border-bottom: 0; }
  .angaben dt { font-size: 0.75rem; color: var(--text-leise); }
  .angaben dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .angaben dd small { font-weight: 400; color: var(--text-leise); }
  .eintrag__mehr { margin-top: auto; font-weight: 600; }
  .eintrag__angebot { align-self: flex-start; margin: 0 0 0.75rem; }
  .eintrag__bestellen { margin-top: auto; align-self: flex-start; }
  .hinweis { margin-top: 3.5rem; padding: clamp(1.5rem, 4vw, 2.25rem); background: var(--ziegel-hell); border-color: color-mix(in srgb, var(--ziegel) 25%, transparent); }
  .hinweis h2 { font-size: 1.5rem; }
  .hinweis p { margin: 0; max-width: 62ch; }
  .hinweis p + p { margin-top: 0.75rem; }
</style>

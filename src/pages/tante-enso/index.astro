---
import Basis from '../../layouts/Basis.astro';
import { Image, getImage } from 'astro:assets';
import { aktion, aktionLaeuft } from '../../lib/enso';
import patenPlakat from '../../assets/fotos/tante-enso-paten.jpg';

const laeuft = aktionLaeuft();
// Paten laut Aushang „Unsere Paten – Hilfe bei der Anmeldung“
const patenGross = await getImage({ src: patenPlakat, width: 900 });
const paten = ['Jonas Domaschka', 'Nadine Wahl', 'Judith Dörr', 'Kirsten Antritter', 'Markus Dörr', 'Paul Miller', 'Christoph Schell', 'Jasmin Fritz', 'Marc Ahne'];
const quellen = [
  { titel: 'Lauterbacher Anzeiger: 222 Anteile schon gezeichnet – Tante Enso soll das „Lädchen“ in Stockhausen retten', href: 'https://www.lauterbacher-anzeiger.de/vogelsbergkreis/herbstein/222-anteile-schon-gezeichnet-tante-enso-soll-das-laedchen-in-stockhausen-retten-94509284.html' },
  { titel: 'Osthessen|News: Stockhausen kämpft um Erhalt seines „Lädchens“ – Tante Enso als Rettungsanker', href: 'https://osthessen-news.de/n11800665/rettung-fuer-das-ladchen-stockhausen-kampft-um-seine-nahversorgung.html' },
  { titel: 'Lauterbacher Anzeiger: Tante Enso übernimmt tegut-Läden in Freiensteinau und Stockhausen', href: 'https://www.lauterbacher-anzeiger.de/vogelsbergkreis/herbstein/tante-enso-uebernimmt-tegut-laeden-in-freiensteinau-und-stockhausen-94348982.html' },
  { titel: 'hessenschau: Diese 16 tegut-Filialen werden in Hessen zu Tante-Enso-Läden', href: 'https://www.hessenschau.de/wirtschaft/diese-16-tegut-filialen-werden-in-hessen-zu-tante-enso-laeden-v1,tante-enso-104.html' },
];
---
<Basis titel="Tante Enso" beschreibung="Das Lädchen in Stockhausen wird ein Tante-Enso-Laden. Alles zu Teilhabern, Fristen und Hilfe beim Zeichnen.">
  <section class="huelle seitenkopf">
    <span class="kicker">Einkaufen im Dorf</span>
    <h1>Tante Enso fürs Lädchen</h1>
    <p>Nach dem Rückzug von tegut soll das Lädchen in der Welzgasse ein Tante-Enso-Laden werden. Betreiber bleibt die Gemeinschaft Altenschlirf. Dafür mussten mindestens {aktion.ziel} Menschen aus Stockhausen und Umgebung Teilhaber werden. Dieses Ziel ist erreicht: Laut Tante Enso kommt dann eine Filiale in den Ort.</p>
    <p><a class="knopf knopf--leise" href={aktion.standort} rel="noopener">Tante Enso Stockhausen auf tanteenso.de</a></p>
  </section>

  <section class="huelle enso-seite">
    {laeuft && (
      <div class="karte aktion">
        <div class="aktion__zahl">
          <strong>{aktion.stand}</strong>
          <span>von {aktion.ziel}<br />Teilhabern</span>
        </div>
        <div>
          <span class="kicker">Ziel erreicht</span>
          <h2>{aktion.stand} von {aktion.ziel} Teilhaberschaften sind gezeichnet</h2>
          <p>Stand {aktion.standText}, die nächste Aktualisierung kommt am {aktion.naechsterStandText}. Die Kampagne läuft bis {aktion.fristText}. Jede weiteren 100 Teilhaber bringen dem Dorf {aktion.praemie} € „Dorfsponsoringprämie“ für ein Projekt nach Wahl. Mitmachen können auch Menschen aus den Nachbarorten.</p>
          <a class="knopf" href={aktion.link} rel="noopener">Anteile online zeichnen</a>
        </div>
      </div>
    )}

    <div class="schritte">
      <article class="karte">
        <span class="schritte__nr">1</span>
        <h2>Anteil zeichnen</h2>
        <p>Ein Anteil kostet einmalig {aktion.preis} €, mehrere sind möglich. Auf jeden Anteil gibt es jährlich 5 % Guthaben, also 5 € zum Einkaufen. Anteile sind jährlich kündbar.</p>
        <p>Wichtig: Jede Person braucht ein eigenes Kundenkonto bei Tante Enso, sonst wird sie nicht gezählt. Mehrere Anteile einer Person zählen als eine Teilhaberschaft.</p>
      </article>
      <article class="karte">
        <span class="schritte__nr">2</span>
        <h2>Karte erhalten</h2>
        <p>Mit der Tante-Enso-Karte öffnet sich die Tür rund um die Uhr – auch in jedem anderen Tante-Enso-Laden in Deutschland. Bezahlt wird an der Selbstbedienungskasse.</p>
      </article>
      <article class="karte">
        <span class="schritte__nr">3</span>
        <h2>Einkaufen</h2>
        <p>Zu den Servicezeiten ist Personal im Laden, und alle können einkaufen – auch ohne Karte. Geplant ist ein Sortiment mit mindestens 3.000 Artikeln, darunter regionale Produkte.</p>
      </article>
    </div>

    <div class="zweier">
      <div class="karte vor-ort">
        <h2>Stand in Stockhausen</h2>
        <dl>
          <dt>Laden</dt>
          <dd>„Lädchen für alles“, Welzgasse 1, 36358 Herbstein-Stockhausen</dd>
          <dt>Bisher</dt>
          <dd>Betrieben von der Gemeinschaft Altenschlirf, beliefert von tegut. tegut hat die Belieferung zum 12. Oktober 2026 beendet.</dd>
          <dt>Betreiber</dt>
          <dd>Die Gemeinschaft Altenschlirf bleibt Betreiberin des Lädchens, Tante Enso kommt als Partner dazu.</dd>
          <dt>Übergang</dt>
          <dd>Tante Enso hat angekündigt, schon vor Ende der Anteilsaktion einzusteigen und den Laden zu beliefern.</dd>
          <dt>Umbau</dt>
          <dd>Die Umstellung der ehemaligen tegut-Läden auf Tante Enso ist von November 2026 bis April 2027 geplant. Ein Termin für Stockhausen steht noch nicht fest.</dd>
          <dt>Öffnungszeiten</dt>
          <dd>Lädchen derzeit: Montag bis Freitag 8–18 Uhr, Samstag 7–13 Uhr<br />Tante Enso: noch nicht festgelegt. Teilhaber können über „Mitgestalten“ bei Tante Enso mitentscheiden, von den Öffnungszeiten bis zum Sortiment.</dd>
        </dl>
      </div>
      <div class="karte vor-ort">
        <h2>Hilfe beim Zeichnen</h2>
        <p>Neun Paten aus dem Dorf helfen bei Fragen zu Tante Enso, beim Zeichnen der Anteile im Internet und beim Beantragen der Karte. Sprechzeiten gibt es bis zum 19. Oktober in der Altfellhalle (Bleichstraße 19) und im Lädchen (Welzgasse 1).</p>
        <dl>
          <dt>Nächste Sprechzeit</dt>
          <dd>Montag, 19. Oktober 2026, 18–20 Uhr<br /><span class="fehlt">[fehlt: Ort – Altfellhalle oder Lädchen]</span></dd>
          <dt>Paten</dt>
          <dd>{paten.join(', ')}</dd>
          <dt>Tante Enso</dt>
          <dd>Fragen zum Anteilskauf beantwortet Tante Enso über das Kontaktformular auf <a href={aktion.standort} rel="noopener">tanteenso.de</a>. Dort gibt es auch ein Erklärvideo zum Zeichnen und zur Karte.</dd>
        </dl>
        <a class="paten-plakat" href={patenGross.src} title="Plakat in voller Größe öffnen">
          <Image src={patenPlakat} alt={`Plakat „Unsere Paten – Hilfe bei der Anmeldung“ mit Fotos von ${paten.join(', ')}`} widths={[360, 560, 800]} sizes="(max-width: 860px) 90vw, 420px" />
        </a>
      </div>
    </div>

    <aside class="quellen">
      <h2>Quellen</h2>
      <ul>
        {quellen.map((q) => <li><a href={q.href} rel="noopener">{q.titel}</a></li>)}
        <li><a href={aktion.standort} rel="noopener">Tante Enso: Standort Stockhausen</a></li>
        <li><a href={aktion.link} rel="noopener">Tante Enso: Teilhaberschaft</a></li>
        <li><a href="https://www.tanteenso.de/content/tanteenso/tante-enso-karte" rel="noopener">Tante Enso: Tante-Enso-Karte</a></li>
      </ul>
    </aside>
  </section>
</Basis>

<style>
  .enso-seite { padding-block: 1rem 5rem; display: grid; gap: 2rem; }
  .aktion {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    color: #f4efe3;
    border: 0;
    background:
      radial-gradient(500px 300px at 100% 100%, color-mix(in srgb, var(--ziegel) 55%, transparent), transparent 70%),
      linear-gradient(140deg, #17405c, #2a6a8c);
  }
  .aktion .kicker { color: var(--gold); }
  .aktion h2 { color: #fff; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .aktion p { color: #dce9f1; max-width: 52ch; }
  .aktion .knopf { background: var(--gold); color: #2a211c; }
  .aktion .knopf:hover { background: #fff; color: #2a211c; }
  .aktion__zahl {
    display: grid;
    place-items: center;
    width: clamp(8rem, 18vw, 11rem);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--gold) 70%, transparent);
    text-align: center;
    line-height: 1.1;
  }
  .aktion__zahl strong { font-family: var(--serif); font-size: clamp(2.6rem, 6vw, 3.6rem); color: #fff; display: block; }
  .aktion__zahl span { font-size: 0.85rem; color: var(--gold); }
  @media (max-width: 640px) { .aktion { grid-template-columns: 1fr; } }

  .schritte { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1rem; }
  .schritte article { padding: 1.75rem; }
  .schritte h2 { font-size: 1.4rem; margin-top: 1rem; }
  .schritte p { margin: 0; color: var(--text-leise); }
  .schritte p + p { margin-top: 0.75rem; }
  .schritte__nr {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--ziegel-hell);
    color: var(--ziegel);
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.2rem;
  }
  .zweier { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 860px) { .zweier { grid-template-columns: 1fr; } }
  .vor-ort { padding: clamp(1.5rem, 4vw, 2.25rem); }
  .vor-ort h2 { font-size: 1.5rem; }
  .vor-ort dl { display: grid; grid-template-columns: 9rem 1fr; gap: 0.8rem 1.25rem; margin: 1.25rem 0 0; }
  .vor-ort dt { font-weight: 600; }
  .vor-ort dd { margin: 0; }
  @media (max-width: 640px) { .vor-ort dl { grid-template-columns: 1fr; gap: 0.2rem; } .vor-ort dd { margin-bottom: 0.8rem; } }
  .paten-plakat { display: block; margin-top: 1.5rem; max-width: 420px; border-radius: 12px; overflow: hidden; border: 1px solid var(--linie); }
  .paten-plakat img { width: 100%; }
  .quellen { font-size: 0.9rem; color: var(--text-leise); }
  .quellen h2 { font-size: 1.1rem; }
  .quellen ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.3rem; }
</style>
